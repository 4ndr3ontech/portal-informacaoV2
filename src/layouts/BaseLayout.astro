---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {  
  title,  
  description = "O mundo inteiro em um só lugar - Diretório Global de Fontes de Informação",
  image = "/logo-globo.png" 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url);
const socialImageURL = new URL(image, Astro.site || Astro.url);

const GA_TRACKING_ID = '';
---

<!doctype html>
<html lang="pt-BR" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo-globo.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2726453991272476" crossorigin="anonymous"></script>

    <!-- Admitad Verification -->
    <meta name="mitgo-verification" content="6602d31c-39ef-46a7-8cfc-f070748a0d9b" />

    <!-- SEO Básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google Analytics -->
    {GA_TRACKING_ID && (
      <script type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${GA_TRACKING_ID}`}></script>
      <script type="text/partytown" define:vars={{ id: GA_TRACKING_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', id);
      </script>
    )}
  </head>
  <body class="min-h-full flex flex-col bg-slate-50 text-slate-900 antialiased selection:bg-cyan-500 selection:text-slate-950 relative">
    
    <Header />

    <main class="flex-1 w-full">
      <slot />
    </main>

    <Footer />

    <!-- Botão Voltar ao Topo -->
    <button
      id="back-to-top-btn"
      type="button"
      aria-label="Voltar ao topo da página"
      class="fixed bottom-6 right-6 z-40 hidden items-center justify-center w-12 h-12 rounded-2xl bg-slate-900 text-cyan-400 border border-slate-700/80 shadow-2xl hover:bg-cyan-500 hover:text-slate-950 hover:border-cyan-400 transition-all duration-300 active:scale-95 cursor-pointer group"
    >
      <span class="text-xl font-black transition-transform duration-300 group-hover:-translate-y-0.5">↑</span>
    </button>

    <!-- Modal Popup de Ficha Técnica Completa -->
    <div 
      id="source-detail-modal" 
      class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/60 backdrop-blur-sm p-4 sm:p-6"
    >
      <div class="relative w-full max-w-2xl rounded-3xl bg-white border border-slate-200 p-6 sm:p-10 shadow-2xl space-y-6">
        
        <button 
          id="close-modal-btn" 
          type="button" 
          class="absolute top-6 right-6 text-slate-400 hover:text-slate-600 bg-slate-100 hover:bg-slate-200 p-2 rounded-full transition-colors cursor-pointer"
          aria-label="Fechar"
        >
          ✕
        </button>

        <div class="flex flex-wrap items-center gap-3 text-xs font-black text-slate-800 uppercase tracking-wider">
          <span id="modal-source-type-badge" class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200">PORTAL</span>
          <span>PAÍS: <strong id="modal-source-country">BR</strong></span>
          <span>IDIOMA: <strong id="modal-source-language">PT-BR</strong></span>
        </div>

        <h2 id="modal-source-name" class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Nome do Veículo
        </h2>

        <div class="space-y-2">
          <h3 class="text-lg font-extrabold text-slate-900">Sobre o Veículo</h3>
          <p id="modal-source-desc" class="text-slate-800 text-base font-bold leading-relaxed">
            Carregando informações sobre a plataforma...
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div>
            <span class="block text-xs font-black text-slate-800 mb-1">Tipo de Mídia:</span>
            <span id="modal-grid-type" class="text-slate-900 font-extrabold capitalize">Portal</span>
          </div>
          <div>
            <span class="block text-xs font-black text-slate-800 mb-1">Última Verificação:</span>
            <span id="modal-source-verified" class="text-slate-900 font-extrabold">2026-10-20</span>
          </div>
          <div>
            <span class="block text-xs font-black text-slate-800 mb-1">Situação:</span>
            <span class="text-emerald-600 font-black">Ativo e Verificado</span>
          </div>
        </div>

        <div class="space-y-2 pt-2">
          <h3 class="text-lg font-extrabold text-slate-900">Categorias Cobertas</h3>
          <div id="modal-source-categories" class="flex flex-wrap gap-3 font-black text-slate-900 text-sm">
          </div>
        </div>

        <div class="pt-6 border-t border-slate-100 text-center space-y-4">
          <p class="text-sm font-extrabold text-slate-800">
            Você será redirecionado para o site oficial e independente de <span id="modal-source-footer-name">Fonte</span>.
          </p>
          <a 
            id="modal-source-link" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="track-click-btn inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-black text-xs uppercase tracking-wider transition-all shadow-md shadow-cyan-600/20"
          >
            Acessar Site Oficial ↗
          </a>
        </div>

      </div>
    </div>

    <script>
      function setupBackToTop() {
        const backToTopBtn = document.getElementById('back-to-top-btn');
        if (!backToTopBtn) return;
        const toggleVisibility = () => {
          if (window.scrollY > 300) {
            backToTopBtn.classList.remove('hidden');
            backToTopBtn.classList.add('flex');
          } else {
            backToTopBtn.classList.add('hidden');
            backToTopBtn.classList.remove('flex');
          }
        };
        window.addEventListener('scroll', toggleVisibility, { passive: true });
        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        toggleVisibility();
      }

      function setupSourcePopup() {
        if ((window as any).__POPUP_EVENT_BOUND__) return;
        (window as any).__POPUP_EVENT_BOUND__ = true;

        document.addEventListener('click', (event) => {
          const target = event.target as HTMLElement | null;
          const modalBtn = target?.closest('.open-source-modal') as HTMLButtonElement | null;
          
          if (modalBtn) {
            const rawData = modalBtn.getAttribute('data-source');
            if (!rawData) return;
            try {
              const source = JSON.parse(rawData);
              const modal = document.getElementById('source-detail-modal');
              if (!modal) return;

              const els = {
                name: document.getElementById('modal-source-name'),
                footerName: document.getElementById('modal-source-footer-name'),
                desc: document.getElementById('modal-source-desc'),
                country: document.getElementById('modal-source-country'),
                lang: document.getElementById('modal-source-language'),
                badgeType: document.getElementById('modal-source-type-badge'),
                gridType: document.getElementById('modal-grid-type'),
                verified: document.getElementById('modal-source-verified'),
                cats: document.getElementById('modal-source-categories'),
                link: document.getElementById('modal-source-link') as HTMLAnchorElement | null
              };

              if (els.name) els.name.textContent = source.name;
              if (els.footerName) els.footerName.textContent = source.name;
              if (els.desc) els.desc.textContent = source.description || 'Descrição não informada.';
              if (els.country) els.country.textContent = source.country || 'BR';
              if (els.lang) els.lang.textContent = source.language || 'PT-BR';
              if (els.badgeType) els.badgeType.textContent = (source.type || 'PORTAL').toUpperCase();
              if (els.gridType) els.gridType.textContent = source.type || 'Portal';
              if (els.verified) els.verified.textContent = source.lastVerified || '2026-10-20';

              if (els.link) {
                els.link.href = source.url || '#';
                els.link.setAttribute('data-track-source', source.id || '');
              }

              if (els.cats) {
                els.cats.innerHTML = '';
                const cats = source.categories || ['Geral'];
                cats.forEach((cat: string) => {
                  const span = document.createElement('span');
                  span.className = 'px-3 py-1 bg-slate-100 border border-slate-200 rounded-lg text-slate-900 text-sm font-black capitalize';
                  span.textContent = cat;
                  els.cats?.appendChild(span);
                });
              }

              modal.classList.remove('hidden');
              modal.classList.add('flex');
              document.body.style.overflow = 'hidden';
            } catch (err) {
              console.error('Erro ao carregar dados do modal:', err);
            }
          }

          const modal = document.getElementById('source-detail-modal');
          if (modal && !modal.classList.contains('hidden')) {
            if (
              target?.id === 'close-modal-btn' ||
              target?.closest('#close-modal-btn') ||
              target === modal
            ) {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
              document.body.style.overflow = '';
            }
          }
        });
      }

      setupBackToTop();
      setupSourcePopup();
      document.addEventListener('astro:page-load', () => {
        setupBackToTop();
        setupSourcePopup();
      });
    </script>
  </body>
</html>

<style is:global>
  * { font-weight: 900 !important; }
  html, body {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
  h1, h2, h3, h4, h5, h6 { line-height: 1.15 !important; letter-spacing: -0.015em !important; }
  p, li, article { line-height: 1.6 !important; letter-spacing: 0.015em !important; }
</style>