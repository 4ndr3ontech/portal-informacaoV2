---
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-black border-t border-neutral-900 transition-colors duration-200 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    
    <!-- Grid de 12 colunas para controlo preciso do alinhamento -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12">
      
      <!-- Coluna 1: Marca, Descrição e Redes Sociais -->
      <div class="md:col-span-12 lg:col-span-5 space-y-4 lg:pr-12">
        <a href="/" class="inline-block group focus:outline-none">
          <span class="text-2xl font-black text-white tracking-tight transition-all duration-300 group-hover:opacity-90">
            OMundoEmUm<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400">CLICK</span>
          </span>
        </a>
        <p class="text-sm font-bold text-slate-400 leading-relaxed max-w-sm">
          O seu diretório global de fontes de informação confiáveis e ofertas rigorosamente curadas. Acesso direto às principais manchetes.
        </p>
        
        <!-- Ícones de Redes Sociais -->
        <div class="flex items-center gap-4 pt-2">
          <!-- X (Twitter) -->
          <a href="#" aria-label="Siga-nos no X (Twitter)" class="text-slate-500 hover:text-cyan-400 transition-colors">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a href="#" aria-label="Siga-nos no Instagram" class="text-slate-500 hover:text-cyan-400 transition-colors">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"/>
            </svg>
          </a>
          <!-- LinkedIn -->
          <a href="#" aria-label="Siga-nos no LinkedIn" class="text-slate-500 hover:text-cyan-400 transition-colors">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Coluna 2: Navegação Principal -->
      <div class="md:col-span-4 lg:col-span-2">
        <h3 class="text-sm font-black text-white uppercase tracking-wider mb-4">
          Navegação
        </h3>
        <ul class="space-y-3 text-sm font-bold">
          <li><a href="/noticias" class="text-slate-400 hover:text-cyan-400 transition-colors">Últimas Notícias</a></li>
          <li><a href="/ofertas" class="text-slate-400 hover:text-cyan-400 transition-colors">Ofertas em Destaque</a></li>
          <li><a href="/categorias/brasil" class="text-slate-400 hover:text-cyan-400 transition-colors">Notícias do Brasil</a></li>
          <li><a href="/categorias/mundo" class="text-slate-400 hover:text-cyan-400 transition-colors">Imprensa Internacional</a></li>
        </ul>
      </div>

      <!-- Coluna 3: Institucional -->
      <div class="md:col-span-4 lg:col-span-2">
        <h3 class="text-sm font-black text-white uppercase tracking-wider mb-4">
          Institucional
        </h3>
        <ul class="space-y-3 text-sm font-bold">
          <li><a href="/sobre" class="text-slate-400 hover:text-cyan-400 transition-colors">Sobre Nós</a></li>
          <li><a href="/contato" class="text-slate-400 hover:text-cyan-400 transition-colors">Entrar em Contato</a></li>
          <li><a href="/privacidade" class="text-slate-400 hover:text-cyan-400 transition-colors">Política de Privacidade</a></li>
          <li><a href="/termos" class="text-slate-400 hover:text-cyan-400 transition-colors">Termos de Uso</a></li>
        </ul>
      </div>

      <!-- Coluna 4: Newsletter -->
      <div class="md:col-span-4 lg:col-span-3">
        <h3 class="text-sm font-black text-white uppercase tracking-wider mb-4">
          Boletim Informativo
        </h3>
        <p class="text-sm font-bold text-slate-400 mb-4 leading-relaxed">
          Inscreva-se para receber novidades e as melhores ofertas diretamente no seu e-mail.
        </p>
        <form action="#" class="flex flex-col gap-3">
          <input 
            type="email" 
            placeholder="Seu melhor e-mail" 
            class="w-full px-4 py-2.5 text-sm font-bold rounded-xl border border-neutral-800 bg-neutral-900 text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all shadow-inner"
            required
          />
          <button 
            type="submit" 
            class="w-full px-4 py-2.5 text-sm font-black uppercase tracking-wider text-slate-950 bg-cyan-500 hover:bg-cyan-400 rounded-xl transition-all cursor-pointer shadow-md shadow-cyan-500/20 active:scale-95"
          >
            Inscrever-se
          </button>
        </form>
      </div>

    </div>

    <!-- Linha Divisória Inferior -->
    <hr class="my-8 border-neutral-900" />

    <!-- Direitos de Autor e Avisos Legais -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-bold text-slate-500">
      <p class="text-center md:text-left">
        &copy; {currentYear} OMundoEmUmCLICK. Todos os direitos reservados.
      </p>
      <p class="text-center md:text-right max-w-lg">
        Os links de afiliados encontram-se devidamente identificados em conformidade com as nossas diretrizes de transparência comercial.
      </p>
    </div>
  </div>
</footer>