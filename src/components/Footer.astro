---
// Garante o ano correto no fuso horário do Brasil, evitando bugs de servidor (UTC) na virada do ano
const currentYear = new Intl.DateTimeFormat('pt-BR', {
  timeZone: 'America/Sao_Paulo',
  year: 'numeric',
}).format(new Date());

const categories = [
  { href: '/noticias?category=brasil', label: 'Brasil' },
  { href: '/noticias?category=mundo', label: 'Mundo' },
  { href: '/noticias?category=politica', label: 'Política' },
  { href: '/noticias?category=economia', label: 'Economia' },
  { href: '/noticias?category=tecnologia', label: 'Tecnologia' },
  { href: '/noticias?category=games', label: 'Games' },
  { href: '/noticias?category=esportes', label: 'Esportes' },
  { href: '/noticias?category=ciencia', label: 'Ciência' },
  { href: '/noticias?category=saude', label: 'Saúde' },
];

const institutionalLinks = [
  { href: '/sobre', label: 'Sobre o portal' },
  { href: '/metodologia', label: 'Critérios de curadoria' },
  { href: '/contato', label: 'Contato' },
  { href: '/privacidade', label: 'Política de privacidade' },
  { href: '/termos', label: 'Termos de uso' },
];
---

<footer class="border-t border-slate-800 bg-slate-950 pt-14 pb-8">

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Conteúdo principal -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 pb-12 border-b border-slate-800">

      <!-- Marca e apresentação -->
      <section class="space-y-5">

        <a
          href="/"
          class="inline-flex items-center transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 rounded-lg"
          aria-label="O Mundo em um Clique - Página inicial"
        >
          <img
            src="/images/logo.png"
            alt="O Mundo em um Clique"
            width="250"
            height="60"
            loading="lazy"
            decoding="async"
            class="h-10 sm:h-12 w-auto object-contain"
          />
        </a>

        <h2 class="text-sm font-bold text-slate-200">
          O mundo inteiro em um só lugar.
        </h2>

        <p class="text-sm text-slate-400 leading-relaxed">
          O Mundo em um Clique organiza fontes de informação do Brasil e do
          exterior em um único ambiente. Explore veículos de comunicação,
          publicações especializadas e conteúdos de diferentes áreas.
        </p>

        <p class="text-xs text-slate-500 leading-relaxed">
          Acesse as publicações originais e consulte diretamente cada veículo
          para acompanhar suas notícias e informações.
        </p>

      </section>

      <!-- Categorias -->
      <nav aria-label="Categorias disponíveis">

        <h2 class="text-xs font-black text-slate-100 uppercase tracking-widest mb-5">
          Explore por categoria
        </h2>

        <ul class="grid grid-cols-2 sm:grid-cols-1 gap-x-4 gap-y-3">

          {categories.map((category) => (
            <li>
              <a
                href={category.href}
                class="text-sm text-slate-400 hover:text-cyan-400 transition-colors focus-visible:outline-none focus-visible:text-cyan-400"
              >
                {category.label}
              </a>
            </li>
          ))}

        </ul>

      </nav>

      <!-- Institucional -->
      <nav aria-label="Informações institucionais">

        <h2 class="text-xs font-black text-slate-100 uppercase tracking-widest mb-5">
          Institucional
        </h2>

        <ul class="space-y-3">

          {institutionalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-slate-400 hover:text-cyan-400 transition-colors focus-visible:outline-none focus-visible:text-cyan-400"
              >
                {link.label}
              </a>
            </li>
          ))}

        </ul>

      </nav>

      <!-- Ofertas e transparência -->
      <section class="space-y-5">

        <div>

          <h2 class="text-xs font-black text-slate-100 uppercase tracking-widest mb-5">
            Ofertas e recomendações
          </h2>

          <p class="text-sm text-slate-400 leading-relaxed">
            Consulte ofertas de produtos e oportunidades de compra
            disponibilizadas no portal.
          </p>

          <a
            href="/ofertas"
            class="inline-flex items-center gap-2 mt-4 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors focus-visible:outline-none focus-visible:underline"
          >
            Explorar ofertas
            <span aria-hidden="true">→</span>
          </a>

        </div>

        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">

          <h3 class="text-xs font-bold text-slate-200 mb-2">
            Transparência comercial
          </h3>

          <p class="text-xs text-slate-400 leading-relaxed">
            Algumas ofertas podem conter links de afiliados. Quando uma compra
            é realizada por meio desses links, o portal pode receber uma
            comissão, sem custo adicional para o comprador.
          </p>

        </div>

      </section>

    </div>

    <!-- Informações complementares -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-5 pt-8">

      <p class="text-xs text-slate-500 leading-relaxed">
        © {currentYear} O Mundo em um Clique. Todos os direitos reservados.
      </p>

      <p class="max-w-2xl text-xs text-slate-500 leading-relaxed md:text-right">
        O portal é um diretório independente de fontes de informação.
        Os conteúdos publicados nos sites de terceiros são de responsabilidade
        de seus respectivos autores e veículos.
      </p>

    </div>

  </div>

</footer>