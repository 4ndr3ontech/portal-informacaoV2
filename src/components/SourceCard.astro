---
import { getFaviconUrl, getCountryFlag, getCategoryIcon } from '../lib/utils';
import type { NewsSource } from '../types';

interface Props {
  source: NewsSource;
  featured?: boolean;
}

const { source, featured = false } = Astro.props;
const favicon = getFaviconUrl(source.url, 128);
const flag = getCountryFlag(source.country || 'Global');
const categories = source.categories || [];
---

<!-- Cartão com fundo branco limpo e bordas suaves -->
<article
  class:list={[
    "group relative h-full flex flex-col justify-between rounded-2xl border transition-all duration-300 overflow-hidden bg-white",
    featured
      ? "border-cyan-500/40 bg-gradient-to-b from-cyan-50/40 to-white p-6 shadow-md shadow-cyan-500/10 hover:border-cyan-500 hover:shadow-2xl hover:shadow-cyan-500/15"
      : "border-slate-200/80 p-5 shadow-sm hover:-translate-y-1 hover:border-cyan-500/40 hover:shadow-xl hover:shadow-slate-200/70"
  ]}
>
  <!-- Detalhe decorativo de borda no hover -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-cyan-500 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

  <div class="flex-1 flex flex-col">
    <!-- Cabeçalho: Logo + Nome + Bandeira + Badge -->
    <div class="flex items-start justify-between gap-3 mb-3.5">
      <div class="flex items-center gap-3.5">
        <!-- Favicon -->
        <div class="relative shrink-0">
          <img
            src={favicon}
            alt={`Logo ${source.name}`}
            class:list={[
              "rounded-xl bg-slate-50 p-1.5 object-contain border border-slate-200/80 group-hover:border-cyan-500/50 transition-all duration-300 shadow-sm",
              featured ? "h-14 w-14" : "h-12 w-12"
            ]}
            loading="lazy"
            decoding="async" 
            onerror="this.onerror=null; this.src='/default-icon.svg';"
          />
        </div>

        <div>
          <!-- Título principal -->
          <a
            href={`/site/${source.id}`}
            class="text-left font-bold text-slate-900 text-lg sm:text-xl tracking-tight leading-snug hover:text-cyan-600 transition-colors cursor-pointer block line-clamp-1"
          >
            {source.name}
          </a>
          
          <!-- Metadados -->
          <p class="text-[10px] sm:text-xs text-slate-500 flex items-center gap-1.5 mt-0.5 tracking-widest uppercase font-mono">
            <span title={`País: ${source.country}`}>{flag}</span>
            <span>{source.country}</span>
            <span class="text-slate-300">•</span>
            <span class="capitalize font-sans text-slate-600">{(source as any).type || 'Portal'}</span>
          </p>
        </div>
      </div>

      <!-- Badge de Verificado -->
      {source.active && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50/90 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-widest border border-emerald-200/80 shrink-0 shadow-2xs">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          Verificado
        </span>
      )}
    </div>

    <!-- Descrição -->
    <div class="min-h-[2.5rem] mb-4 flex items-start">
      <p class="text-xs sm:text-sm text-slate-600 font-medium line-clamp-2 leading-relaxed tracking-wide w-full">
        {source.description || 'Sem descrição disponível.'}
      </p>
    </div>
  </div>

  <!-- Rodapé do Card: Categorias e Botões -->
  <div class="pt-3.5 border-t border-slate-100 flex items-center justify-between gap-2 mt-auto">
    <!-- Categorias -->
    <div class="flex flex-wrap gap-1.5">
      {categories.slice(0, 2).map((cat) => (
        <span class="font-bold text-[10px] px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 border border-slate-200/60 flex items-center gap-1.5 uppercase tracking-wider transition-colors hover:bg-slate-200/60">
          <span class="text-xs">{getCategoryIcon(cat)}</span>
          <span class="capitalize">{cat}</span>
        </span>
      ))}
    </div>

    <div class="flex items-center gap-3">
      <!-- Link para Detalhes -->
      <a 
        href={`/site/${source.id}`} 
        class="hidden sm:inline-block text-[10px] font-black uppercase tracking-wider text-cyan-600 hover:text-cyan-800 transition-colors"
      >
        Detalhes
      </a>

      <!-- Botão Acessar -->
      <a
        href={source.url}
        target="_blank"
        rel="noopener noreferrer"
        data-track-source={source.id}
        class="track-click-btn inline-flex items-center font-bold gap-1.5 px-3 py-1.5 rounded-lg bg-cyan-50 hover:bg-cyan-500 text-cyan-700 hover:text-white border border-cyan-200/60 hover:border-cyan-500 text-xs uppercase tracking-wider transition-all duration-200 group/btn shadow-2xs shrink-0"
      >
        <span>Acessar</span>
        <span class="text-sm transition-transform duration-200 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5">↗</span>
      </a>
    </div>
  </div>
</article>