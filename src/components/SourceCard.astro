---
import { getFaviconUrl, getCountryFlag, getCategoryIcon } from '../lib/utils';
import type { NewsSource } from '../types';

interface Props {
  source: NewsSource;
  featured?: boolean;
}

const { source, featured = false } = Astro.props;
const favicon = getFaviconUrl(source.url);
const flag = getCountryFlag(source.country);
---

<div
  class:list={[
    "group relative flex flex-col justify-between rounded-xl border transition-all duration-300",
    featured
      ? "border-cyan-500/50 bg-slate-800/90 p-6 shadow-lg shadow-cyan-500/10 hover:border-cyan-400 hover:shadow-cyan-500/20"
      : "border-slate-800 bg-slate-900/70 p-5 hover:-translate-y-1 hover:border-cyan-500/40 hover:bg-slate-900 hover:shadow-xl hover:shadow-cyan-500/5"
  ]}
>
  <div>
    <!-- Cabeçalho: Logo + Nome + Bandeira + Badge -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-center gap-3">
        <img
          src={favicon}
          alt={`Logo ${source.name}`}
          class="h-10 w-10 rounded-lg bg-slate-800 p-1.5 object-contain border border-slate-700/60 group-hover:border-cyan-500/40 transition-colors"
          loading="lazy"
          {...{ onerror: "this.onerror=null; this.src='/default-icon.svg';" }}
        />
        <div>
          <h3 class="font-semibold text-white text-base group-hover:text-cyan-400 transition-colors">
            {source.name}
          </h3>
          <p class="text-xs text-slate-400 flex items-center gap-1 mt-0.5">
            <span title={`País: ${source.country}`}>{flag}</span>
            <span class="uppercase tracking-wider text-[10px] font-mono text-slate-400">{source.country}</span>
            <span class="text-slate-600">•</span>
            <span class="capitalize text-slate-300">{source.type}</span>
          </p>
        </div>
      </div>

      {source.active && (
        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-[11px] font-medium text-emerald-400 border border-emerald-500/20">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Verificado
        </span>
      )}
    </div>

    <!-- Descrição da Fonte -->
    <p class="text-sm text-slate-300 line-clamp-2 mb-4 leading-relaxed font-normal">
      {source.description}
    </p>
  </div>

  <!-- Rodapé do Card: Categorias e Link Externo -->
  <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between gap-2">
    <div class="flex flex-wrap gap-1">
      {source.categories.slice(0, 2).map((cat) => (
        <span class="text-[11px] px-2 py-0.5 rounded-md bg-slate-800 text-slate-300 border border-slate-700/50 flex items-center gap-1">
          <span>{getCategoryIcon(cat)}</span>
          <span class="capitalize">{cat}</span>
        </span>
      ))}
    </div>

    <a
      href={source.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-xs font-semibold text-cyan-400 hover:text-cyan-300 group-hover:translate-x-0.5 transition-all"
    >
      Acessar <span class="text-sm">↗</span>
    </a>
  </div>
</div>