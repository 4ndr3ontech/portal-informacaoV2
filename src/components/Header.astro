---
import { getCategoryIcon } from '../lib/utils';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/noticias', label: 'Notícias' },
  { href: '/ofertas', label: 'Ofertas' },
  { href: '/sobre', label: 'Sobre' },
];

const categories = [
  { slug: 'brasil', label: 'Brasil' },
  { slug: 'mundo', label: 'Mundo' },
  { slug: 'politica', label: 'Política' },
  { slug: 'economia', label: 'Economia' },
  { slug: 'tecnologia', label: 'Tecnologia' },
  { slug: 'esportes', label: 'Esportes' },
  { slug: 'ciencia', label: 'Ciência' },
  { slug: 'saude', label: 'Saúde' },
];

const currentDate = new Date().toLocaleDateString('pt-BR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long'
});
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-xl transition-all">
  
  <!-- Topbar Informativa -->
  <div class="hidden sm:block border-b border-slate-800/50 bg-slate-900/40 py-1.5 px-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between text-[11px] text-slate-400 font-medium">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Fontes Atualizadas em Tempo Real
        </span>
        <span class="text-slate-700">•</span>
        <span class="capitalize text-slate-400">{currentDate}</span>
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <a href="/contato" class="hover:text-cyan-400 transition-colors">Contato</a>
        <a href="/privacidade" class="hover:text-cyan-400 transition-colors">Privacidade</a>
      </div>
    </div>
  </div>

  <!-- Main Header Navigation -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 sm:h-20 flex items-center justify-between gap-4">
    
    <!-- Logo Modernizado (Esquerda) -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none flex-shrink-0">
      <div class="relative flex items-center justify-center h-11 w-11 sm:h-12 sm:w-12 rounded-2xl bg-gradient-to-tr from-cyan-500 via-blue-600 to-indigo-600 p-0.5 shadow-lg shadow-cyan-500/20 group-hover:shadow-cyan-500/40 group-hover:scale-105 transition-all duration-300">
        <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center">
          <span class="font-black text-2xl sm:text-3xl text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400">
            P
          </span>
        </div>
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-2">
          <span class="text-2xl sm:text-3xl font-black tracking-tight text-white group-hover:text-cyan-400 transition-colors">
            Portal<span class="text-cyan-400">Info</span>
          </span>
          <span class="hidden sm:inline-block px-1.5 py-0.5 rounded text-[10px] font-bold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 uppercase tracking-widest">
            PRO
          </span>
        </div>
        <span class="text-[10px] text-slate-400 tracking-wider uppercase font-mono font-medium -mt-1 hidden sm:block">
          Diretório de Mídia
        </span>
      </div>
    </a>

    <!-- Nav Links Centralizados (Centro) -->
    <nav class="hidden md:flex items-center justify-center flex-1 max-w-sm mx-auto">
      <div class="flex items-center gap-1 bg-slate-900/80 p-1.5 rounded-2xl border border-slate-800/80 shadow-inner">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class:list={[
                "px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200",
                isActive
                  ? "bg-cyan-500 text-slate-950 shadow-md shadow-cyan-500/20 font-bold"
                  : "text-slate-300 hover:text-white hover:bg-slate-800/60"
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </div>
    </nav>

    <!-- Ações e Busca (Direita) -->
    <div class="flex items-center gap-2.5 flex-shrink-0">
      <a
        href="/noticias"
        class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-cyan-400 hover:border-cyan-500/40 transition-all cursor-pointer flex items-center justify-center"
        title="Buscar veículos"
      >
        🔍
      </a>

      <button
        type="button"
        class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-amber-400 hover:border-amber-500/40 transition-all cursor-pointer"
        title="Alternar tema"
      >
        ☀️
      </button>

      <!-- Botão Acessar Rápido -->
      <a
        href="/noticias"
        class="hidden lg:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold text-xs shadow-lg shadow-cyan-500/15 transition-all active:scale-95"
      >
        Explorar Fontes ↗
      </a>
    </div>
  </div>

  <!-- Sub-barra com Pills de Categorias Centralizadas -->
  <div class="border-t border-slate-900 bg-slate-950/60 py-2.5 overflow-x-auto scrollbar-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-center flex-wrap gap-2 text-xs font-medium">
      <span class="text-slate-500 text-[11px] font-mono uppercase tracking-wider pr-1 hidden sm:inline-block">Categorias:</span>
      {categories.map((cat) => (
        <a
          href={`/noticias?category=${encodeURIComponent(cat.slug)}`}
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-900/80 border border-slate-800 text-slate-300 hover:text-white hover:border-cyan-500/40 hover:bg-slate-800 transition-all duration-200 whitespace-nowrap"
        >
          <span>{getCategoryIcon(cat.slug)}</span>
          <span>{cat.label}</span>
        </a>
      ))}
    </div>
  </div>

</header>