---
import { getCategoryIcon } from '../lib/utils';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/noticias', label: 'Notícias' },
  { href: '/ofertas', label: 'Ofertas' },
  { href: '/sobre', label: 'Sobre' },
];

const categories = [
  { slug: 'brasil', label: 'Brasil' },
  { slug: 'mundo', label: 'Mundo' },
  { slug: 'politica', label: 'Política' },
  { slug: 'economia', label: 'Economia' },
  { slug: 'tecnologia', label: 'Tecnologia' },
  { slug: 'esportes', label: 'Esportes' },
  { slug: 'ciencia', label: 'Ciência' },
  { slug: 'saude', label: 'Saúde' },
];

const currentDate = new Date().toLocaleDateString('pt-BR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long'
});
---

<header class="sticky top-0 z-50 w-full border-b border-neutral-900 bg-black transition-all">
  
  <!-- Topbar Informativa -->
  <div class="hidden sm:block border-b border-neutral-900 bg-black py-1.5 px-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between text-[11px] text-slate-400 font-medium">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Fontes Atualizadas em Tempo Real
        </span>
        <span class="text-slate-700">•</span>
        <span class="capitalize text-slate-400">{currentDate}</span>
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <a href="/contato" class="hover:text-cyan-400 transition-colors">Contato</a>
        <a href="/privacidade" class="hover:text-cyan-400 transition-colors">Privacidade</a>
      </div>
    </div>
  </div>

  <!-- Main Header Navigation -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 sm:h-24 flex items-center justify-between gap-4">
    
    <!-- Logo Modernizado Premium (Esquerda) -->
    <a href="/" class="flex items-center gap-3.5 sm:gap-4 group focus:outline-none flex-shrink-0 transition-transform hover:scale-[1.02]">
      <!-- Ícone 'M' aumentado -->
      <div class="relative flex items-center justify-center h-12 w-12 sm:h-14 sm:w-14 rounded-2xl bg-gradient-to-tr from-cyan-500 via-blue-600 to-indigo-600 p-0.5 shadow-lg shadow-cyan-500/20 group-hover:shadow-cyan-500/40 transition-all duration-300">
        <div class="w-full h-full bg-black rounded-[14px] flex items-center justify-center">
          <span class="font-black text-2xl sm:text-3xl text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400">
            M
          </span>
        </div>
      </div>
      
      <div class="flex flex-col justify-center">
        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Novo Título: OMundoEmUmCLICK -->
          <span class="text-2xl sm:text-3xl md:text-4xl font-black text-white tracking-tight transition-all duration-300 group-hover:opacity-90">
            OMundoEmUm<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400">CLICK</span>
          </span>
          <span class="hidden sm:inline-flex px-2 py-0.5 rounded-lg text-[10px] font-black bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 uppercase tracking-widest mt-1">
            PRO
          </span>
        </div>
        <!-- Subtítulo mais elegante e espaçado -->
        <span class="text-[10px] sm:text-xs text-slate-400 tracking-[0.25em] uppercase font-bold mt-0.5 hidden sm:block">
          Diretório de Mídia
        </span>
      </div>
    </a>

    <!-- Nav Links Centralizados (Centro) -->
    <nav class="hidden md:flex items-center justify-center flex-1 max-w-sm mx-auto">
      <div id="nav-container" class="flex items-center gap-1 bg-neutral-900/80 p-1.5 rounded-2xl border border-neutral-800 shadow-inner">
        {navLinks.map((link) => {
          const isOfertas = link.href === '/ofertas';
          const isActive = currentPath === link.href || (currentPath === '/' && isOfertas);
          
          return (
            <a
              href={link.href}
              class:list={[
                "nav-pill px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200",
                isActive
                  ? "bg-cyan-500 text-slate-950 shadow-md shadow-cyan-500/20 font-bold"
                  : "text-slate-300 hover:text-white hover:bg-neutral-800"
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </div>
    </nav>

    <!-- Ações e Login Admin (Direita) -->
    <div class="flex items-center gap-2.5 flex-shrink-0">
      <button
        type="button"
        class="p-2.5 rounded-xl bg-neutral-900 border border-neutral-800 text-slate-300 hover:text-amber-400 hover:border-amber-500/40 transition-all cursor-pointer"
        title="Alternar tema"
      >
        ☀️
      </button>

      <!-- Botão Entrar (Área Admin / Restrita) -->
      <a
        href="/admin/login"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-neutral-900 border border-neutral-800 hover:border-cyan-500/50 text-slate-200 hover:text-cyan-400 font-semibold text-xs transition-all shadow-sm"
        title="Acesso restrito para administradores"
      >
        <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Entrar</span>
      </a>
    </div>
  </div>

  <!-- Sub-barra com Pills de Categorias Centralizadas -->
  <div class="border-t border-neutral-900 bg-black py-2.5 overflow-x-auto scrollbar-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-center flex-wrap gap-2 text-xs font-medium">
      <span class="text-slate-500 text-[11px] font-mono uppercase tracking-wider pr-1 hidden sm:inline-block">Categorias:</span>
      {categories.map((cat) => (
        <a
          href={`/noticias?category=${encodeURIComponent(cat.slug)}`}
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-neutral-900/80 border border-neutral-800 text-slate-300 hover:text-white hover:border-cyan-500/40 hover:bg-neutral-800 transition-all duration-200 whitespace-nowrap"
        >
          <span>{getCategoryIcon(cat.slug)}</span>
          <span>{cat.label}</span>
        </a>
      ))}
    </div>
  </div>

</header>

<script>
  // Move a pílula de destaque azul ao clicar nas opções do menu
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('.nav-pill');
    
    pills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        // Remove o destaque de todos
        pills.forEach(p => {
          p.classList.remove('bg-cyan-500', 'text-slate-950', 'shadow-md', 'shadow-cyan-500/20', 'font-bold');
          p.classList.add('text-slate-300', 'hover:text-white', 'hover:bg-neutral-800');
        });
        
        // Aplica o destaque azul padrão no botão clicado
        const target = e.currentTarget as HTMLElement;
        target.classList.remove('text-slate-300', 'hover:text-white', 'hover:bg-neutral-800');
        target.classList.add('bg-cyan-500', 'text-slate-950', 'shadow-md', 'shadow-cyan-500/20', 'font-bold');
      });
    });
  });
</script>