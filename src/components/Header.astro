---
import { getCategoryIcon } from '../lib/utils';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/noticias', label: 'Notícias' },
  { href: '/ofertas', label: 'Ofertas' },
  { href: '/sobre', label: 'Sobre' },
];

const categories = [
  { slug: 'brasil', label: 'Brasil' },
  { slug: 'mundo', label: 'Mundo' },
  { slug: 'politica', label: 'Política' },
  { slug: 'economia', label: 'Economia' },
  { slug: 'tecnologia', label: 'Tecnologia' },
  { slug: 'esportes', label: 'Esportes' },
  { slug: 'ciencia', label: 'Ciência' },
  { slug: 'saude', label: 'Saúde' },
];

const currentDate = new Date().toLocaleDateString('pt-BR', {
  weekday: 'long',
  day: 'numeric',
  month: 'long'
});
---

<header class="sticky top-0 z-50 w-full border-b border-neutral-900 bg-black transition-all shadow-xl shadow-black/50">
  
  <!-- Topbar Informativa -->
  <div class="hidden sm:block border-b border-neutral-900/50 bg-black py-1.5 px-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between text-[11px] text-slate-400 font-medium tracking-wide">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Fontes Atualizadas em Tempo Real
        </span>
        <span class="text-slate-700">•</span>
        <span class="capitalize text-slate-400">{currentDate}</span>
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <a href="/contato" class="hover:text-cyan-400 transition-colors">Contato</a>
        <a href="/privacidade" class="hover:text-cyan-400 transition-colors">Privacidade</a>
      </div>
    </div>
  </div>

  <!-- Main Header Navigation (Altura padronizada para h-20 sm:h-24) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 sm:h-24 flex items-center justify-between">
    
    <!-- Esquerda: Logo Alinhado e com Tamanho Padronizado -->
    <div class="flex-1 flex justify-start items-center">
      <a href="/" class="flex items-center transition-transform hover:opacity-90 active:scale-95" aria-label="Página inicial OMundoEmUmCLICK">
        <img 
          src="/images/logo.png" 
          alt="Logótipo OMundoEmUmCLICK" 
          class="w-[180px] sm:w-[240px] md:w-[280px] h-auto object-contain"
        />
      </a>
    </div>

    <!-- Centro: Nav Links Perfeitamente Centralizados -->
    <nav class="hidden md:flex items-center justify-center flex-shrink-0">
      <div id="nav-container" class="flex items-center gap-1 bg-neutral-900/80 p-1.5 rounded-2xl border border-neutral-800 shadow-inner">
        {navLinks.map((link) => {
          const isOfertas = link.href === '/ofertas';
          const isActive = currentPath === link.href || (currentPath === '/' && isOfertas);
          
          return (
            <a
              href={link.href}
              class:list={[
                "nav-pill px-5 py-2 rounded-xl text-sm font-semibold transition-all duration-200 tracking-wide",
                isActive
                  ? "bg-cyan-500 text-slate-950 shadow-md shadow-cyan-500/20 font-bold"
                  : "text-slate-300 hover:text-white hover:bg-neutral-800"
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </div>
    </nav>

    <!-- Direita: Ações e Login -->
    <div class="flex-1 flex justify-end items-center gap-2.5">
      <a
        href="/admin/login"
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-neutral-900 border border-neutral-800 hover:border-cyan-500/50 text-slate-200 hover:text-cyan-400 font-semibold text-xs transition-all shadow-sm tracking-wide"
        title="Acesso restrito para administradores"
      >
        <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Entrar</span>
      </a>
    </div>
  </div>

  <!-- Sub-barra com Pills de Categorias -->
  <div class="border-t border-neutral-900 bg-black py-3 overflow-x-auto scrollbar-none">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-center flex-wrap gap-2.5 text-xs font-medium">
      <span class="text-slate-500 text-[11px] font-mono uppercase tracking-widest pr-2 hidden sm:inline-block">Categorias:</span>
      {categories.map((cat) => (
        <a
          href={`/noticias?category=${encodeURIComponent(cat.slug)}`}
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-neutral-900/80 border border-neutral-800 text-slate-300 hover:text-white hover:border-cyan-500/40 hover:bg-neutral-800 transition-all duration-200 whitespace-nowrap shadow-sm"
        >
          <span>{getCategoryIcon(cat.slug)}</span>
          <span>{cat.label}</span>
        </a>
      ))}
    </div>
  </div>

</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('.nav-pill');
    
    pills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        pills.forEach(p => {
          p.classList.remove('bg-cyan-500', 'text-slate-950', 'shadow-md', 'shadow-cyan-500/20', 'font-bold');
          p.classList.add('text-slate-300', 'hover:text-white', 'hover:bg-neutral-800');
        });
        
        const target = e.currentTarget as HTMLElement;
        target.classList.remove('text-slate-300', 'hover:text-white', 'hover:bg-neutral-800');
        target.classList.add('bg-cyan-500', 'text-slate-950', 'shadow-md', 'shadow-cyan-500/20', 'font-bold');
      });
    });
  });
</script>