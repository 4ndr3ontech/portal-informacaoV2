---
import type { NewsSource } from '../types';
import NewsSourceCard from './NewsSourceCard.astro';
import EmptyState from './EmptyState.astro';

interface Props {
  sources: NewsSource[];
}

const { sources } = Astro.props;
---

{sources.length === 0 ? (
  <EmptyState 
    title="Nenhuma fonte de notícia encontrada" 
    description="Tente ajustar sua busca ou selecionar uma categoria diferente." 
  />
) : (
  <div class="source-grid">
    {sources.map((source) => (
      <NewsSourceCard source={source} />
    ))}
  </div>
)}

<style>
  .source-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .source-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .source-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>