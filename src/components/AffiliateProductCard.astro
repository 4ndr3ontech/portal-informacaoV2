---
import type { AffiliateProduct } from '../types';
import { sanitizeUrl, getAffiliateLinkProps } from '../lib/links';

interface Props {
  product: AffiliateProduct;
}

const { product } = Astro.props;
const safeAffiliateUrl = sanitizeUrl(product.affiliateUrl);
const affiliateProps = getAffiliateLinkProps();

const formattedPrice = product.price 
  ? new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(product.price)
  : null;

const fallbackSvg = "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23f1f5f9'/><text x='50%' y='50%' dominant-baseline='middle' text-anchor='middle' fill='%2394a3b8' font-size='12'>Imagem Indisponível</text></svg>";
---

<article class="product-card">
  <div class="card-badge">Oferta Recomendada</div>
  
  <div class="image-wrapper">
    <img 
      src={product.imageUrl} 
      alt={`Imagem do produto ${product.name}`} 
      loading="lazy"
      decoding="async"
      data-fallback={fallbackSvg}
    />
  </div>

  <div class="card-content">
    <span class="product-category">{product.category}</span>
    <h3 class="product-title">{product.name}</h3>
    <p class="product-desc">{product.description}</p>

    <div class="price-area">
      {formattedPrice ? (
        <div class="price-value">
          <span class="price">{formattedPrice}</span>
          {product.lastPriceCheck && (
            <span class="price-check">Verificado em {product.lastPriceCheck}</span>
          )}
        </div>
      ) : (
        <span class="price-consult">Consultar preço na loja</span>
      )}
    </div>

    <div class="card-action">
      <a 
        href={safeAffiliateUrl} 
        {...affiliateProps}
        class="buy-button"
      >
        Ver Oferta no Mercado Livre ↗
      </a>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLImageElement>('.image-wrapper img').forEach((img) => {
    img.addEventListener('error', () => {
      const fallback = img.getAttribute('data-fallback');
      if (fallback && img.src !== fallback) {
        img.src = fallback;
      }
    });
  });
</script>

<style>
  .product-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    position: relative;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .product-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .card-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background-color: #ffe600;
    color: #2d3277;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    z-index: 2;
  }

  .image-wrapper {
    width: 100%;
    height: 180px;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .image-wrapper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .card-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-category {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .product-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .product-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .price-area {
    margin-top: auto;
    margin-bottom: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
  }

  .price-value {
    display: flex;
    flex-direction: column;
  }

  .price {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .price-check {
    font-size: 0.725rem;
    color: var(--text-muted);
  }

  .price-consult {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .buy-button {
    display: block;
    width: 100%;
    text-align: center;
    background-color: #ffe600;
    color: #2d3277;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-md);
    transition: filter 0.2s;
  }

  .buy-button:hover {
    filter: brightness(0.95);
    text-decoration: none;
  }
</style>