---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro'; 
import { getAllNiches, getSourcesByCategory } from '../../utils/filterSources';
import type { Category } from '../../types';

export async function getStaticPaths() {
  const categories = getAllNiches();
  
  return categories.map((category) => {
    const seoData: Record<string, { title: string, desc: string }> = {
      'tecnologia': { title: 'Fontes de Tecnologia e Inovação', desc: 'Descubra os melhores sites e portais de tecnologia, inovação e ciência.' },
      'economia': { title: 'Notícias de Economia e Negócios', desc: 'As principais fontes sobre o mercado financeiro, negócios e economia.' },
      'brasil': { title: 'Notícias do Brasil', desc: 'Acompanhe os principais portais de notícias do Brasil em tempo real.' },
      'politica': { title: 'Notícias de Política', desc: 'Fontes confiáveis e conceituadas para acompanhar o cenário político.' },
      'esportes': { title: 'Notícias de Desporto', desc: 'Os melhores sites de desporto, futebol e competições desportivas.' },
      'mundo': { title: 'Notícias do Mundo', desc: 'Cobertura internacional e geopolítica global.' },
      'ciencia': { title: 'Notícias de Ciência', desc: 'Fontes sobre descobertas científicas e exploração espacial.' },
      'saude': { title: 'Notícias de Saúde e Bem-Estar', desc: 'Portais com dicas de bem-estar, medicina e saúde.' },
    };

    return {
      params: { slug: category },
      props: { 
        categoryName: category,
        seo: seoData[category] || { title: `Notícias de ${category}`, desc: `Encontre fontes de informação sobre ${category}.` }
      },
    };
  });
}

const { slug } = Astro.params;
const { seo } = Astro.props;

// Dupla asserção resolve a validação estrita do TypeScript
const sources = getSourcesByCategory(slug as unknown as Category);
---

<BaseLayout title={`${seo.title} | OMundoEmUmCLICK`} description={seo.desc}>
  <main class="min-h-screen bg-slate-50 pb-16">
    
    <!-- CABEÇALHO CLARO (FUNDO BRANCO) -->
    <header class="bg-white text-slate-900 py-12 px-4 border-b border-slate-200">
      <div class="max-w-7xl mx-auto space-y-3">
        <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900">
          {seo.title}
        </h1>
        <p class="text-slate-600 font-bold max-w-2xl text-lg">
          {seo.desc}
        </p>
      </div>
    </header>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
      <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
        <h2 class="text-lg font-black text-slate-800">
          {sources.length} fontes verificadas encontradas
        </h2>
        <a href="/" class="text-sm font-black text-cyan-600 hover:text-cyan-700 transition-colors flex items-center gap-1">
          &larr; Voltar ao início
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sources.map((source) => (
          <article class="bg-white p-6 rounded-3xl shadow-sm border border-slate-200 hover:shadow-md transition-all flex flex-col">
            <div class="flex items-center gap-3 mb-3">
              <span class="bg-slate-100 text-slate-800 text-xs px-2.5 py-1 rounded-lg font-black uppercase tracking-wider border border-slate-200">
                {source.country}
              </span>
              <h3 class="text-xl font-black text-slate-900 truncate">
                {source.name}
              </h3>
            </div>
            
            <p class="text-slate-600 font-bold text-sm mb-6 line-clamp-3 flex-grow leading-relaxed">
              {source.description}
            </p>
            
            <div class="mt-auto pt-4 border-t border-slate-100 flex justify-between items-center">
              <span class="text-xs text-green-700 font-black flex items-center gap-1.5 bg-green-50 px-2.5 py-1 rounded-full border border-green-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                Verificado
              </span>
              
              <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-cyan-600 hover:text-cyan-700 font-black hover:underline flex items-center gap-1.5 text-sm transition-colors">
                Aceder ao Site 
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>