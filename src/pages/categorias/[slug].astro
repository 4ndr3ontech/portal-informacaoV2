---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceCard from '../../components/SourceCard.astro';
import { categories } from '../../data/categories';
import { sources } from '../../data/sources';
import { searchSources } from '../../lib/search';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat }
  }));
}

const { category } = Astro.props;
const categorySources = searchSources(sources, { category: category.slug });
---

<BaseLayout 
  title={`Notícias e Fontes de ${category.name} | PortalInfo`}
  description={category.description}
>
  <!-- Contentor principal centralizado -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full space-y-8">
    
    <!-- Breadcrumbs / Navegação -->
    <nav aria-label="Navegação estruturada" class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Início</a>
      <span>&gt;</span>
      <a href="/noticias" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Notícias</a>
      <span>&gt;</span>
      <span class="text-slate-900 dark:text-slate-200 font-medium">{category.name}</span>
    </nav>

    <!-- Cabeçalho da Categoria -->
    <header class="space-y-2 border-b border-slate-200 dark:border-slate-800/80 pb-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Fontes de {category.name}
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base max-w-3xl">
        {category.description}
      </p>
    </header>

    <!-- Grelha de Fontes -->
    <section>
      {categorySources.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {categorySources.map(source => (
            <SourceCard source={source} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16 bg-white dark:bg-slate-900/60 rounded-2xl border border-slate-200 dark:border-slate-800 p-8">
          <p class="text-slate-600 dark:text-slate-400 text-base mb-4">
            Nenhuma fonte encontrada nesta categoria no momento.
          </p>
          <a
            href="/noticias"
            class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-sm font-semibold text-white bg-cyan-600 hover:bg-cyan-700 dark:bg-cyan-500 dark:hover:bg-cyan-400 transition-colors"
          >
            Ver todas as notícias
          </a>
        </div>
      )}
    </section>

  </div>
</BaseLayout>