---
import BaseLayout from '../../layouts/BaseLayout.astro';
import sources from '../../data/clean-news-sources.json';

export const prerender = true;

export async function getStaticPaths() {
  const categories = [
    { slug: 'brasil', name: 'Brasil', description: 'Principais veículos de notícias nacionais e regionais do país.', icon: '🇧🇷' },
    { slug: 'mundo', name: 'Mundo', description: 'Análises, agências internacionais e acontecimentos globais.', icon: '🌍' },
    { slug: 'politica', name: 'Política', description: 'Bastidores dos poderes executivo, legislativo e judiciário.', icon: '⚖️' },
    { slug: 'economia', name: 'Economia', description: 'Mercado financeiro, negócios, câmbio e indicadores econômicos.', icon: '📈' },
    { slug: 'tecnologia', name: 'Tecnologia', description: 'Inovação, inteligência artificial, hardware, software e segurança digital.', icon: '💻' },
    { slug: 'games', name: 'Games', description: 'Indústria dos jogos eletrônicos, análises, hardware gamer e eSports.', icon: '🎮' },
    { slug: 'esportes', name: 'Esportes', description: 'Futebol nacional, internacional e modalidades olímpicas.', icon: '⚽' },
    { slug: 'ciencia', name: 'Ciência', description: 'Descobertas científicas, pesquisas acadêmicas, espaço e saúde.', icon: '🔬' }
  ];

  return categories.map(cat => ({
    params: { slug: cat.slug },
    props: { category: cat }
  }));
}

const { category } = Astro.props;

// Filtrar fontes associadas a esta categoria a partir do dataset unificado
const categorySources = sources.filter((s: any) => {
  if (!s.categories || !Array.isArray(s.categories)) return false;
  return s.categories.some((c: string) => c.toLowerCase().includes(category.slug));
});
---

<BaseLayout title={`${category.name} — O Mundo em um Clique`}>
  
  <!-- Cabeçalho da Categoria -->
  <section class="bg-slate-950 text-white py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
    <div class="max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-500/30 text-cyan-400 text-xs font-black uppercase tracking-wider">
        <span>Categoria Editorial</span>
      </div>
      
      <div class="text-5xl">{category.icon}</div>
      
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white">
        Fontes de Informação: {category.name}
      </h1>
      
      <p class="text-base sm:text-lg font-bold text-slate-300 max-w-2xl mx-auto leading-relaxed">
        {category.description} Explore portais verificados e referências independentes selecionadas para esta editoria.
      </p>
    </div>
  </section>

  <!-- Conteúdo Informativo e Lista de Fontes -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full space-y-10">
    
    <!-- Guia de Utilização da Categoria -->
    <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm space-y-4">
      <h2 class="text-xl font-black text-slate-900">Sobre esta editoria no diretório</h2>
      <p class="text-slate-600 font-bold text-sm leading-relaxed">
        A curadoria da categoria <strong>{category.name}</strong> reúne portais independentes e publicações de referência. O nosso objetivo é fornecer um acesso rápido e transparente para que possa consultar diretamente as fontes originais com total segurança e praticidade.
      </p>
    </div>

    <!-- Grelha de Fontes Catalogadas -->
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <h3 class="text-2xl font-black text-slate-900 tracking-tight">Veículos Catalogados ({categorySources.length})</h3>
        <span class="text-xs font-bold text-slate-500">Acesso direto ao site oficial</span>
      </div>

      {categorySources.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {categorySources.map((source: any) => (
            <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:border-cyan-500 transition-all duration-300 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <div class="flex items-center justify-between text-xs font-black text-slate-500 uppercase tracking-wider">
                  <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200">{source.mediaType || 'Portal'}</span>
                  <span>{source.country || 'BR'}</span>
                </div>
                <div class="flex items-center gap-3">
                  {source.favicon && (
                    <img src={source.favicon} alt={`Favicon ${source.name}`} class="w-6 h-6 rounded border border-slate-200 object-contain" />
                  )}
                  <h4 class="text-xl font-black text-slate-900 tracking-tight truncate">{source.name}</h4>
                </div>
                <p class="text-xs font-bold text-slate-600 leading-relaxed line-clamp-2">
                  {source.description || 'Portal de informação catalogado no diretório global.'}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs font-bold text-slate-400">Idioma: {source.language || (source.country === 'BR' ? 'pt-BR' : 'en/Multilíngue')}</span>
                <div class="flex items-center gap-2">
                  <a 
                    href={`/fontes/${source.id}`}
                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-black text-xs uppercase tracking-wider transition-all"
                  >
                    Perfil
                  </a>
                  <a 
                    href={source.url} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-slate-900 hover:bg-cyan-600 text-white font-black text-xs uppercase tracking-wider transition-all"
                  >
                    Acessar ↗
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-16 bg-white rounded-3xl border border-slate-200">
          <p class="text-slate-500 font-bold">Nenhuma fonte encontrada especificamente para esta categoria no momento.</p>
        </div>
      )}
    </div>

  </section>

</BaseLayout>