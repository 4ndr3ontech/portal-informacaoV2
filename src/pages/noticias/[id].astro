---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import fontesGlobais from '../../data/clean-news-sources.json';
import { getFaviconUrl, getCountryFlag } from '../../lib/utils';
import type { NewsSource } from '../../types';

export async function getStaticPaths() {
  const rawSources: NewsSource[] = Array.isArray(fontesGlobais)
    ? (fontesGlobais as any)
    : ((fontesGlobais as any).default || []);

  const allSources = Array.from(
    new Map(
      rawSources
        .filter(source => source && source.name && source.id)
        .map(source => [source.name.toLowerCase().trim(), source])
    ).values()
  );

  return allSources.map((source) => ({
    params: { id: source.id },
    props: { source },
  }));
}

const { source } = Astro.props;

const flag = getCountryFlag ? getCountryFlag(source.country || 'Global') : (source.country === 'BR' ? '🇧🇷' : '🌐');
const favicon = source.favicon || (getFaviconUrl ? getFaviconUrl(source.url) : `https://www.google.com/s2/favicons?domain=${source.url}&sz=128`);
---

<BaseLayout title={`${source.name} — Ficha Técnica | O Mundo em um Clique`} description={source.description}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full space-y-6 bg-white">
    
    <a href="/noticias" class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-slate-600 hover:text-cyan-600 transition-colors">
      ← Voltar para o diretório
    </a>

    <article class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm space-y-8">
      
      <div class="space-y-4">
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono font-bold tracking-wider text-slate-500 uppercase">
          <span class="px-2.5 py-1 rounded bg-slate-100 border border-slate-200 text-cyan-700">
            {source.type || 'Portal'}
          </span>
          <span>PAÍS: {flag} {source.country || 'Global'}</span>
          <span>•</span>
          <span>IDIOMA: {source.language || (source.country === 'BR' ? 'pt-BR' : 'en/Multilíngue')}</span>
        </div>

        <div class="flex items-center gap-4">
          <img 
            src={favicon} 
            alt={`Logo de ${source.name}`} 
            class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-slate-100 p-2 border border-slate-200 object-contain"
            onerror="this.style.display='none'"
          />
          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
            {source.name}
          </h1>
        </div>
      </div>

      <hr class="border-slate-200" />

      <div class="space-y-2">
        <h2 class="text-sm font-bold text-slate-500 uppercase tracking-wider">Sobre o Veículo</h2>
        <p class="text-slate-800 text-base sm:text-lg leading-relaxed font-bold">
          {source.description || 'Portal de informação catalogado no diretório global.'}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2">
        <div class="space-y-1">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider block">Tipo de Mídia</span>
          <p class="text-slate-900 font-semibold capitalize">{source.type || 'Portal'}</p>
        </div>
        <div class="space-y-1">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider block">Última Verificação</span>
          <p class="text-slate-900 font-mono font-semibold">{source.lastVerified || new Date().toISOString().split('T')[0]}</p>
        </div>
        <div class="space-y-1">
          <span class="text-xs font-medium text-slate-500 uppercase tracking-wider block">Situação</span>
          <p class="font-semibold flex items-center gap-2 text-sm text-emerald-600">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Ativo e Verificado
          </p>
        </div>
      </div>

      <div class="space-y-3">
        <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Categorias Cobertas</h2>
        <div class="flex flex-wrap gap-2">
          {source.categories && source.categories.map((cat: string) => (
            <a 
              href={`/categorias/${cat.toLowerCase()}`}
              class="px-3 py-1.5 rounded-lg bg-slate-100 border border-slate-200 text-xs font-medium text-slate-700 hover:text-cyan-600 hover:border-cyan-500 transition-all capitalize"
            >
              {cat}
            </a>
          ))}
        </div>
      </div>

      <hr class="border-slate-200" />

      <div class="text-center space-y-4 pt-2">
        <p class="text-xs text-slate-500 font-bold">
          Você será redirecionado para o site oficial e independente de <strong class="text-slate-800">{source.name}</strong>.
        </p>
        <a 
          href={source.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-sm sm:text-base transition-all shadow-lg shadow-cyan-500/10 active:scale-95"
        >
          Acessar {source.name} no site oficial ↗
        </a>
      </div>

    </article>
  </main>
</BaseLayout>