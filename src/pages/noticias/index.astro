---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceCard from '../../components/SourceCard.astro';
import { sources } from '../../data/sources';
import type { NewsSource } from '../../types';

// Captura o termo de busca e o filtro de categoria/tag via URL se existirem
const searchQuery = Astro.url.searchParams.get('q')?.toLowerCase() || '';
const tagQuery = Astro.url.searchParams.get('tag')?.toLowerCase() || '';

// Filtra as fontes de acordo com a pesquisa ou categoria selecionada
const filteredSources = sources.filter((source: NewsSource) => {
  const matchesSearch = 
    searchQuery === '' ||
    source.name.toLowerCase().includes(searchQuery) ||
    source.description.toLowerCase().includes(searchQuery) ||
    source.country.toLowerCase().includes(searchQuery);

  const matchesTag =
    tagQuery === '' ||
    source.categories.includes(tagQuery) ||
    source.type.toLowerCase() === tagQuery;

  return matchesSearch && matchesTag;
});

// Lista de tags para o menu de filtro rápido
const availableTags = [
  { id: '', label: 'Todas' },
  { id: 'brasil', label: 'Brasil' },
  { id: 'mundo', label: 'Mundo' },
  { id: 'politica', label: 'Política' },
  { id: 'economia', label: 'Economia' },
  { id: 'tecnologia', label: 'Tecnologia' },
  { id: 'esportes', label: 'Esportes' },
];
---

<BaseLayout
  title="Diretório de Fontes e Veículos de Notícias | PortalInfo"
  description="Encontre veículos de comunicação confiáveis com direcionamento direto ao conteúdo original."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10 w-full">

    <!-- Cabeçalho da Página de Notícias -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        Diretório de Fontes e Veículos de Notícias
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed">
        Encontre veículos de comunicação confiáveis com direcionamento direto ao conteúdo original.
      </p>

      <!-- Barra de Pesquisa Integrada -->
      <form action="/noticias" method="GET" class="flex items-center max-w-xl mx-auto bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-2xl p-1.5 shadow-sm focus-within:border-cyan-500 transition-all">
        <span class="pl-3 text-slate-400">🔍</span>
        <input
          type="text"
          name="q"
          value={searchQuery}
          placeholder="Buscar por veículo, país ou palavra-chave..."
          class="w-full bg-transparent px-3 py-2 text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none"
        />
        <button
          type="submit"
          class="px-5 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-700 dark:bg-cyan-500 dark:hover:bg-cyan-400 text-white dark:text-slate-950 font-bold text-sm transition-all cursor-pointer shadow-xs whitespace-nowrap"
        >
          Buscar
        </button>
      </form>
    </div>

    <!-- Filtros por Categoria / Tags -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none justify-start sm:justify-center">
      {availableTags.map((tag) => (
        <a
          href={tag.id === '' ? '/noticias' : `/noticias?tag=${tag.id}`}
          class:list={[
            "px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border",
            (tagQuery === tag.id || (tag.id === '' && tagQuery === ''))
              ? "bg-cyan-600 dark:bg-cyan-500 text-white border-cyan-600 dark:border-cyan-500 shadow-sm"
              : "bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-800 hover:border-cyan-500/50"
          ]}
        >
          {tag.label}
        </a>
      ))}
    </div>

    <!-- Contador de Resultados -->
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800/80 pb-4">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">
        {searchQuery ? `Resultados para "${searchQuery}"` : 'Todas as fontes cadastradas'}
      </h2>
      <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
        {filteredSources.length} {filteredSources.length === 1 ? 'veículo encontrado' : 'veículos encontrados'}
      </span>
    </div>

    <!-- Grelha de Cartões Unificada (Usa o componente SourceCard) -->
    <section>
      {filteredSources.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {filteredSources.map((source: NewsSource) => (
            <SourceCard source={source} />
          ))}
        </div>
      ) : (
        <div class="text-center py-20 space-y-3 bg-white dark:bg-slate-900/50 rounded-3xl border border-slate-200 dark:border-slate-800">
          <p class="text-4xl">🔍</p>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Nenhum veículo encontrado</h3>
          <p class="text-sm text-slate-500 dark:text-slate-400">Tente pesquisar por outros termos ou remover os filtros aplicados.</p>
          <div class="pt-2">
            <a href="/noticias" class="inline-block px-4 py-2 rounded-xl bg-cyan-600 text-white text-xs font-bold hover:bg-cyan-700 transition-colors">
              Ver todas as fontes
            </a>
          </div>
        </div>
      )}
    </section>

  </main>
</BaseLayout>