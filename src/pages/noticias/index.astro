---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceCard from '../../components/SourceCard.astro';
import fontesGlobais from '../../data/clean-news-sources.json';
import rawFontesBrasil from '../../data/brazil-sources.json';
import type { NewsSource } from '../../types';

// Garante que os dados sejam tratados como array com segurança
const fontesOriginais: NewsSource[] = Array.isArray(fontesGlobais)
  ? fontesGlobais
  : ((fontesGlobais as any).default || []);

const fontesBrasil: NewsSource[] = Array.isArray(rawFontesBrasil) 
  ? rawFontesBrasil 
  : ((rawFontesBrasil as any).default || []);

const allSources: NewsSource[] = [...fontesOriginais, ...fontesBrasil];
const totalSources = allSources.length;

// === CAPTURA DE PARÂMETROS DA URL (SSR Otimizado para Cloudflare) ===
const url = Astro.url;
const q = (url.searchParams.get('q') || '').toLowerCase().trim();
const category = (url.searchParams.get('category') || '').toLowerCase().trim();
const country = (url.searchParams.get('country') || '').toLowerCase().trim();
const page = parseInt(url.searchParams.get('page') || '1', 10);
const itemsPerPage = 24; // Valor fixo e limpo por página

// Função utilitária para normalizar strings (acentos e maiúsculas)
const normalizeStr = (str: string) => str ? str.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim() : '';

// Filtragem server-side
const filteredSources = allSources.filter(source => {
  const name = normalizeStr(source.name);
  const desc = normalizeStr(source.description);
  const categories = (source.categories || []).map(c => normalizeStr(c));
  const srcCountry = normalizeStr(source.country || 'global');

  let matchQuery = true;
  if (q) {
    const terms = q.split(/\s+/);
    const combined = `${name} ${desc} ${categories.join(' ')} ${srcCountry}`;
    matchQuery = terms.every(term => combined.includes(term));
  }

  let matchCategory = true;
  if (category) {
    matchCategory = categories.includes(category);
  }

  let matchCountry = true;
  if (country) {
    matchCountry = srcCountry === country;
  }

  return matchQuery && matchCategory && matchCountry;
});

const totalFiltered = filteredSources.length;
const totalPages = Math.ceil(totalFiltered / itemsPerPage) || 1;
const currentPage = page > totalPages ? 1 : (page < 1 ? 1 : page);

// Paginação em memória
const startIndex = (currentPage - 1) * itemsPerPage;
const paginatedSources = filteredSources.slice(startIndex, startIndex + itemsPerPage);

const capitalizedCategory = category ? category.charAt(0).toUpperCase() + category.slice(1) : '';
const pageTitleText = q ? `Busca: "${q}"` : (capitalizedCategory || 'Diretório de Fontes');
const pageDescText = category ? `Exibindo veículos especializados na editoria de ${capitalizedCategory}.` : 'Pesquise veículos de comunicação, filtre por palavra-chave ou explore o nosso catálogo completo.';
---

<BaseLayout title={`${pageTitleText} | OMundoEmUmCLICK`}>
  
  <!-- CABEÇALHO CLARO (FUNDO BRANCO) -->
  <header class="bg-white text-slate-900 py-12 px-4 border-b border-slate-200">
    <div class="max-w-3xl mx-auto text-center space-y-6">
      <div>
        <h1 id="page-title" class="text-4xl sm:text-5xl font-bold tracking-tight capitalize text-transparent bg-clip-text bg-gradient-to-r from-cyan-500 to-blue-600 pb-2">
          {pageTitleText}
        </h1>
        <p id="page-desc" class="text-slate-600 font-bold text-lg">
          {pageDescText}
        </p>
      </div>

      <!-- Formulário de Busca -->
      <form method="GET" action="/noticias" id="search-form" class="pt-2">
        {category && <input type="hidden" name="category" value={category} />}
        {country && <input type="hidden" name="country" value={country} />}
        <div class="flex items-center rounded-2xl bg-white border border-slate-300 p-2 shadow-sm focus-within:border-cyan-500 focus-within:ring-2 focus-within:ring-cyan-500/20 transition-all">
          <span class="pl-3 text-slate-400 text-lg">🔍</span>
          <input
            id="search-input"
            type="text"
            name="q"
            value={q}
            aria-label="Buscar por veículo, país ou palavra-chave"
            placeholder="Buscar veículos, países ou palavras-chave..."
            class="w-full bg-transparent px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none text-sm font-bold"
          />
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-black text-sm uppercase tracking-wider transition-all shadow-md active:scale-95 cursor-pointer">
            Buscar
          </button>
        </div>
      </form>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full min-h-screen">
    
    <!-- Barra de Filtros Ativos e Contador -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-200 pb-4 mb-8 gap-4">
      <div class="flex items-center gap-3 flex-wrap">
        <p class="text-sm font-extrabold text-slate-700">
          Exibindo <span id="results-count" class="font-black text-slate-900">{totalFiltered}</span> fontes {q || category || country ? `(filtradas de ${totalSources})` : ''}
        </p>

        {category && (
          <span id="active-category-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-cyan-100 text-cyan-900 border border-cyan-200 capitalize">
            <span id="category-name">{capitalizedCategory}</span>
          </span>
        )}
      </div>

      <div class="flex items-center gap-4 flex-wrap">
        {(q || category || country) && (
          <a href="/noticias" id="clear-filters" class="text-xs font-black uppercase tracking-wider text-cyan-600 hover:text-cyan-500 transition-colors">
            ✕ Limpar Filtros
          </a>
        )}
      </div>
    </div>

    <!-- Grid de Fontes Renderizadas -->
    {paginatedSources.length > 0 ? (
      <div id="sources-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {paginatedSources.map((source: NewsSource) => (
          <SourceCard source={source} />
        ))}
      </div>
    ) : (
      <div id="no-results" class="text-center py-20 space-y-4 bg-white rounded-3xl border border-slate-200 p-8 shadow-sm mt-8">
        <span class="text-5xl">🔍</span>
        <h3 class="text-2xl font-black text-slate-900">Nenhum veículo encontrado</h3>
        <p class="text-slate-600 text-base font-bold">Tente buscar por outros termos ou selecione uma categoria diferente.</p>
        <a href="/noticias" class="inline-block mt-4 px-6 py-3 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-black text-xs uppercase tracking-wider transition-all shadow-md">Ver catálogo completo</a>
      </div>
    )}

    <!-- Controles de Paginação (Sem o seletor "Exibir por página") -->
    {totalPages > 1 && (
      <nav id="pagination-nav" class="flex items-center justify-center gap-4 pt-12" aria-label="Paginação">
        <div class="flex items-center gap-3">
          {currentPage > 1 ? (
            <a href={`/noticias?${new URLSearchParams({ ...(q && { q }), ...(category && { category }), ...(country && { country }), page: (currentPage - 1).toString() }).toString()}`} class="px-5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-800 hover:bg-slate-50 font-bold text-sm transition-all cursor-pointer shadow-sm">← Anterior</a>
          ) : (
            <button disabled class="px-5 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-400 font-bold text-sm opacity-50 cursor-not-allowed">← Anterior</button>
          )}

          <span class="text-sm font-mono text-slate-600 px-3 font-bold">
            Página <strong id="current-page-num" class="text-slate-900 font-black">{currentPage}</strong> de <strong id="total-pages-num" class="text-slate-900 font-black">{totalPages}</strong>
          </span>

          {currentPage < totalPages ? (
            <a href={`/noticias?${new URLSearchParams({ ...(q && { q }), ...(category && { category }), ...(country && { country }), page: (currentPage + 1).toString() }).toString()}`} class="px-5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-800 hover:bg-slate-50 font-bold text-sm transition-all cursor-pointer shadow-sm">Próxima →</a>
          ) : (
            <button disabled class="px-5 py-2.5 rounded-xl bg-white border border-slate-200 text-slate-400 font-bold text-sm opacity-50 cursor-not-allowed">Próxima →</button>
          )}
        </div>
      </nav>
    )}

  </main>
</BaseLayout>