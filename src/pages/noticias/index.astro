---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceCard from '../../components/SourceCard.astro';

import { sources as fontesOriginais } from '../../data/sources';
import fontesBrasil from '../../data/brazil-sources.json';
import type { NewsSource } from '../../types';

const allSources: NewsSource[] = [...fontesOriginais, ...fontesBrasil];
const totalSources = allSources.length;
---

<BaseLayout title="Diretório de Notícias e Veículos | O mundo em um click">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10 w-full">
    
    <!-- Hero / Busca Header -->
    <section class="text-center space-y-4 max-w-3xl mx-auto">
      
      <h1 id="page-title" class="text-3xl sm:text-4xl font-extrabold tracking-tight capitalize bg-gradient-to-r from-cyan-600 to-blue-600 bg-clip-text text-transparent pb-1">
        Diretório de Fontes e Veículos
      </h1>
      
      <p id="page-desc" class="text-slate-600 font-bold text-sm sm:text-base">
        Encontre veículos de comunicação confiáveis organizados por categoria.
      </p>

      <!-- MICRO-SCRIPT 1: Muda o título instantaneamente antes do resto da página carregar -->
      <script is:inline>
        (function() {
          const p = new URLSearchParams(window.location.search);
          const c = p.get('category');
          const q = p.get('q');
          if (c) {
            const cap = c.charAt(0).toUpperCase() + c.slice(1);
            document.getElementById('page-title').textContent = cap;
            document.getElementById('page-desc').textContent = 'Exibindo veículos especializados na editoria de ' + cap + '.';
            document.title = cap + ' | O mundo em um click';
          } else if (q) {
            document.getElementById('page-title').textContent = 'Busca: "' + q + '"';
            document.title = 'Busca: "' + q + '" | O mundo em um click';
          }
        })();
      </script>

      <form id="search-form" class="pt-4">
        <div class="flex items-center rounded-2xl bg-white border border-slate-300 p-2 shadow-xl focus-within:border-cyan-500 focus-within:ring-2 focus-within:ring-cyan-500/20 transition-all">
          <span class="pl-3 text-slate-400 text-lg">🔍</span>
          <input
            id="search-input"
            type="text"
            name="q"
            aria-label="Buscar por veículo, país ou palavra-chave"
            placeholder="Buscar por veículo, país ou palavra-chave..."
            class="w-full bg-transparent px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none text-sm font-bold"
          />
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black text-sm uppercase tracking-wider transition-all shadow-md shadow-cyan-500/20 active:scale-95 cursor-pointer">
            Buscar
          </button>
        </div>
      </form>
    </section>

    <!-- Barra de Filtros Ativos e Contador -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-200 pb-4 gap-4">
      <div class="flex items-center gap-3 flex-wrap">
        <p class="text-sm font-extrabold text-slate-600">
          Exibindo <span id="results-count" class="font-black text-slate-900">{totalSources}</span> fontes
        </p>

        <span id="active-category-badge" class="hidden items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-cyan-100 text-cyan-900 border border-cyan-200 capitalize">
          <span id="category-name">Todas</span>
        </span>
      </div>

      <!-- MICRO-SCRIPT 2: Revela o badge instantaneamente -->
      <script is:inline>
        (function() {
          const p = new URLSearchParams(window.location.search);
          if (p.get('category')) {
            document.getElementById('active-category-badge').classList.remove('hidden');
            document.getElementById('active-category-badge').classList.add('inline-flex');
            document.getElementById('category-name').textContent = p.get('category').charAt(0).toUpperCase() + p.get('category').slice(1);
          }
        })();
      </script>

      <div class="flex items-center gap-4 flex-wrap">
        <a href="/noticias" id="clear-filters" class="hidden text-xs font-black uppercase tracking-wider text-cyan-600 hover:text-cyan-700 transition-colors">
          ✕ Limpar Filtros
        </a>
      </div>
    </div>

    <!-- Grid de Fontes Renderizadas (COM A CLASSE "HIDDEN" POR DEFEITO PARA NÃO TRAVAR O BROWSER) -->
    <div id="sources-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {allSources.map((source: NewsSource, index: number) => (
        <div 
          class="source-card-wrapper hidden" 
          data-index={index}
          data-name={source.name.toLowerCase()} 
          data-desc={(source.description || '').toLowerCase()}
          data-country={(source.country || 'global').toLowerCase()}
          data-categories={source.categories.join(',').toLowerCase()}
        >
          <SourceCard source={source} />
        </div>
      ))}
    </div>

    <!-- Controles de Paginação -->
    <nav id="pagination-nav" class="hidden flex flex-col sm:flex-row items-center justify-center gap-4 pt-8 border-t border-slate-200" aria-label="Paginação">
      <div class="flex items-center gap-3">
        <button id="prev-page-btn" type="button" class="px-4 py-2 rounded-xl bg-white border border-slate-300 text-slate-800 hover:bg-slate-100 font-bold text-sm transition-all cursor-pointer shadow-xs">← Anterior</button>
        <span class="text-sm font-mono text-slate-600 px-3 font-bold">
          Página <strong id="current-page-num" class="text-slate-900 font-black">1</strong> de <strong id="total-pages-num" class="text-slate-900 font-black">1</strong>
        </span>
        <button id="next-page-btn" type="button" class="px-4 py-2 rounded-xl bg-white border border-slate-300 text-slate-800 hover:bg-slate-100 font-bold text-sm transition-all cursor-pointer shadow-xs">Próxima →</button>
      </div>

      <div class="flex items-center gap-2 text-xs text-slate-600 sm:ml-4 sm:pl-4 sm:border-l border-slate-200 font-bold">
        <label for="limit-select" class="font-bold">Exibir por página:</label>
        <select id="limit-select" class="bg-white border border-slate-300 rounded-lg px-2 py-1.5 text-slate-900 font-bold focus:outline-none focus:border-cyan-500 cursor-pointer shadow-2xs">
          <option value="24">24</option>
          <option value="48">48</option>
          <option value="96">96</option>
          <option value="150">150</option>
        </select>
      </div>
    </nav>

    <!-- Mensagem de Nenhuma Fonte Encontrada -->
    <div id="no-results" class="hidden text-center py-16 space-y-3 bg-white rounded-3xl border border-slate-200 p-8 shadow-sm">
      <span class="text-4xl">🔍</span>
      <h3 class="text-xl font-black text-slate-900">Nenhum veículo encontrado</h3>
      <p class="text-slate-600 text-sm font-bold">Tente buscar por outros termos ou selecione uma categoria diferente.</p>
      <a href="/noticias" class="inline-block mt-2 px-5 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black text-xs uppercase tracking-wider transition-all shadow-md">Ver todas as fontes</a>
    </div>

  </main>
</BaseLayout>

<!-- Lógica Principal: Rápida porque só revela 24 itens, em vez de esconder 1300 -->
<script is:inline>
  (function() {
    const urlParams = new URLSearchParams(window.location.search);
    const rawQ = urlParams.get('q') || '';
    const rawCategory = urlParams.get('category') || '';
    const rawCountry = urlParams.get('country') || '';
    const rawLimit = parseInt(urlParams.get('limit')) || 24;
    const itemsPerPage = [24, 48, 96, 150].includes(rawLimit) ? rawLimit : 24;

    const normalizeStr = (str) => str ? str.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim() : '';

    const queryParam = normalizeStr(rawQ);
    const categoryParam = normalizeStr(rawCategory);
    const countryParam = normalizeStr(rawCountry);

    const searchInput = document.getElementById('search-input');
    if (searchInput && rawQ) searchInput.value = rawQ;

    if (rawCategory || rawQ || rawCountry) {
      const clearBtn = document.getElementById('clear-filters');
      if (clearBtn) {
        clearBtn.classList.remove('hidden');
        clearBtn.classList.add('inline-block');
      }
    }

    const limitSelect = document.getElementById('limit-select');
    if (limitSelect) {
      limitSelect.value = itemsPerPage.toString();
      limitSelect.addEventListener('change', (e) => {
        const newLimit = e.target.value;
        const currentUrl = new URL(window.location.href);
        currentUrl.searchParams.set('limit', newLimit);
        currentUrl.searchParams.delete('page');
        window.location.href = currentUrl.toString();
      });
    }

    const cards = document.querySelectorAll('.source-card-wrapper');
    let currentPage = parseInt(urlParams.get('page')) || 1;
    let matchedCards = [];

    function filterAndPaginate() {
      matchedCards = [];

      // Filtra de forma invisível
      cards.forEach(card => {
        const name = card.getAttribute('data-name');
        const desc = card.getAttribute('data-desc');
        const categories = card.getAttribute('data-categories');
        const country = card.getAttribute('data-country');

        let matchQuery = true, matchCategory = true, matchCountry = true;

        if (queryParam) matchQuery = name.includes(queryParam) || desc.includes(queryParam) || categories.includes(queryParam) || country.includes(queryParam);
        if (categoryParam) matchCategory = categories.split(',').includes(categoryParam);
        if (countryParam) matchCountry = country === countryParam;

        if (matchQuery && matchCategory && matchCountry) {
          matchedCards.push(card);
        } else {
          card.classList.add('hidden'); // Garante que ficam ocultos
        }
      });

      const totalVisible = matchedCards.length;
      document.getElementById('results-count').textContent = totalVisible;

      const noResultsEl = document.getElementById('no-results');
      const gridEl = document.getElementById('sources-grid');
      const navEl = document.getElementById('pagination-nav');

      if (totalVisible === 0) {
        if(noResultsEl) noResultsEl.classList.remove('hidden');
        if(gridEl) gridEl.classList.add('hidden');
        if(navEl) navEl.classList.add('hidden');
        return;
      } else {
        if(noResultsEl) noResultsEl.classList.add('hidden');
        if(gridEl) gridEl.classList.remove('hidden');
      }

      const totalPages = Math.ceil(totalVisible / itemsPerPage);
      if (currentPage > totalPages) currentPage = 1;

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;

      // REVELA APENAS OS 24 ITENS NECESSÁRIOS (Isto elimina o engasgo/delay do navegador)
      matchedCards.forEach((card, index) => {
        if (index >= startIndex && index < endIndex) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      if (totalPages > 1 && navEl) {
        navEl.classList.remove('hidden');
        navEl.classList.add('flex');
        document.getElementById('current-page-num').textContent = currentPage;
        document.getElementById('total-pages-num').textContent = totalPages;

        const prevBtn = document.getElementById('prev-page-btn');
        const nextBtn = document.getElementById('next-page-btn');
        if(prevBtn) {
          prevBtn.disabled = currentPage === 1;
          prevBtn.style.opacity = currentPage === 1 ? '0.5' : '1';
        }
        if(nextBtn) {
          nextBtn.disabled = currentPage === totalPages;
          nextBtn.style.opacity = currentPage === totalPages ? '0.5' : '1';
        }
      } else if (navEl) {
        navEl.classList.add('hidden');
      }
    }

    function updatePageUrl(newPage) {
      const currentUrl = new URL(window.location.href);
      currentUrl.searchParams.set('page', newPage);
      window.history.pushState({}, '', currentUrl);
      currentPage = newPage;
      filterAndPaginate();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    const prevBtn = document.getElementById('prev-page-btn');
    if(prevBtn) prevBtn.addEventListener('click', () => { if (currentPage > 1) updatePageUrl(currentPage - 1); });

    const nextBtn = document.getElementById('next-page-btn');
    if(nextBtn) nextBtn.addEventListener('click', () => {
      if (currentPage < Math.ceil(matchedCards.length / itemsPerPage)) updatePageUrl(currentPage + 1);
    });

    filterAndPaginate();

    const searchForm = document.getElementById('search-form');
    if (searchForm) {
      searchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const newQ = searchInput ? searchInput.value.trim() : '';
        const currentUrl = new URL(window.location.href);
        if (newQ) currentUrl.searchParams.set('q', newQ);
        else currentUrl.searchParams.delete('q');
        currentUrl.searchParams.delete('page');
        window.location.href = currentUrl.toString();
      });
    }
  })();
</script>