import SourceCard from '../../components/SourceCard.astro';
import { sources } from '../../data/sources';
import type { NewsSource } from '../../types';

// Captura o termo de busca e o filtro de categoria/tag via URL se existirem
const searchQuery = Astro.url.searchParams.get('q')?.toLowerCase() || '';
const tagQuery = Astro.url.searchParams.get('tag')?.toLowerCase() || '';

// Filtra as fontes de acordo com a pesquisa ou categoria selecionada
const filteredSources = sources.filter((source: NewsSource) => {
  const matchesSearch = 
    searchQuery === '' ||
    source.name.toLowerCase().includes(searchQuery) ||
    source.description.toLowerCase().includes(searchQuery) ||
    source.country.toLowerCase().includes(searchQuery);

  const matchesTag =
    tagQuery === '' ||
    source.categories.includes(tagQuery) ||
    source.type.toLowerCase() === tagQuery;

  return matchesSearch && matchesTag;
});

// Lista de tags para o menu de filtro rápido
