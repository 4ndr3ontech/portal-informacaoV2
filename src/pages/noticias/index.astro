---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBar from '../../components/SearchBar.astro';
import SourceCard from '../../components/SourceCard.astro';
import { sources } from '../../data/sources';
import { categories } from '../../data/categories';
import { searchSources } from '../../lib/search';
import type { NewsSource } from '../../types';

const query = Astro.url.searchParams.get('q') || '';
const categoryFilter = Astro.url.searchParams.get('categoria') || '';

const filteredSources = searchSources(sources, {
  query,
  category: categoryFilter
});
---

<BaseLayout 
  title="Diretório de Fontes e Veículos de Notícias | PortalInfo" 
  description="Explore jornais, portais, revistas e agências de notícias do Brasil e do mundo organizados por categoria."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10 w-full">

    <!-- Cabeçalho da Página de Notícias -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        Diretório de Fontes e Veículos de Notícias
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed">
        Encontre veículos de comunicação confiáveis com direcionamento direto ao conteúdo original.
      </p>

      <!-- Barra de Pesquisa Integrada -->
      <div class="max-xl mx-auto pt-2">
        <SearchBar initialQuery={query} />
      </div>
    </div>

    <!-- Filtros por Categoria / Tags -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none justify-start sm:justify-center">
      <a
        href="/noticias"
        class:list={[
          "px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border",
          !categoryFilter
            ? "bg-cyan-600 dark:bg-cyan-500 text-white border-cyan-600 dark:border-cyan-500 shadow-sm"
            : "bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-800 hover:border-cyan-500/50"
        ]}
      >
        Todas
      </a>
      {categories.map((cat) => (
        <a
          href={`/noticias?categoria=${cat.slug}${query ? `&q=${query}` : ''}`}
          class:list={[
            "px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border",
            categoryFilter === cat.slug
              ? "bg-cyan-600 dark:bg-cyan-500 text-white border-cyan-600 dark:border-cyan-500 shadow-sm"
              : "bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-800 hover:border-cyan-500/50"
          ]}
        >
          {cat.name}
        </a>
      ))}
    </div>

    <!-- Contador de Resultados -->
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800/80 pb-4">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">
        {categoryFilter 
          ? `Fontes na categoria "${categories.find(c => c.slug === categoryFilter)?.name || categoryFilter}"`
          : query 
            ? `Resultados para "${query}"` 
            : 'Todas as fontes cadastradas'}
      </h2>
      <span class="text-xs font-medium text-slate-500 dark:text-slate-400">
        {filteredSources.length} {filteredSources.length === 1 ? 'veículo encontrado' : 'veículos encontrados'}
      </span>
    </div>

    <!-- Grelha de Cartões Unificada -->
    <section>
      {filteredSources.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {filteredSources.map((source: NewsSource) => (
            <SourceCard source={source} />
          ))}
        </div>
      ) : (
        <div class="text-center py-20 space-y-3 bg-white dark:bg-slate-900/50 rounded-3xl border border-slate-200 dark:border-slate-800">
          <p class="text-4xl">🔍</p>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Nenhum veículo encontrado</h3>
          <p class="text-sm text-slate-500 dark:text-slate-400">Tente pesquisar por outros termos ou remover os filtros aplicados.</p>
          <div class="pt-2">
            <a href="/noticias" class="inline-block px-4 py-2 rounded-xl bg-cyan-600 text-white text-xs font-bold hover:bg-cyan-700 transition-colors">
              Ver todas as fontes
            </a>
          </div>
        </div>
      )}
    </section>

  </main>
</BaseLayout>