---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import FeaturedSource from '../components/FeaturedSource.astro';
import NewsSourceList from '../components/NewsSourceList.astro';
import { sources } from '../data/sources';
import { categories } from '../data/categories';

const featuredSource = sources.find((s) => s.id === 'bbc-news-brasil') || sources[0];
const nationalSources = sources.filter((s) => !s.isInternational).slice(0, 6);
const internationalSources = sources.filter((s) => s.isInternational).slice(0, 3);
---

<BaseLayout 
  title="Início" 
  description="Central de notícias verificadas do Brasil e do mundo organizadas por categoria e relevância editorial."
>
  <div class="container">
    <section class="hero-section">
      <h1>Fontes de Informação Confiáveis</h1>
      <p class="hero-subtitle">
        Direcionamento simples e direto aos principais veículos de jornalismo do Brasil e do mundo.
      </p>
      
      <div class="search-box">
        <SearchBar />
      </div>
    </section>

    <section class="categories-section">
      <h2 class="section-title">Explore por Categoria</h2>
      <div class="category-grid">
        {categories.slice(0, 8).map((cat) => (
          <a href={`/categorias/${cat.slug}`} class="category-card">
            <span class="cat-name">{cat.name}</span>
            <span class="cat-desc">{cat.description}</span>
          </a>
        ))}
      </div>
    </section>

    {featuredSource && (
      <section class="featured-section">
        <FeaturedSource source={featuredSource} />
      </section>
    )}

    <section class="sources-section">
      <div class="section-header">
        <h2>Principais Veículos Nacionais</h2>
        <a href="/noticias" class="see-all">Ver todas as fontes &rarr;</a>
      </div>
      <NewsSourceList sources={nationalSources} />
    </section>

    <section class="sources-section international">
      <div class="section-header">
        <h2>Fontes e Agências Internacionais</h2>
        <a href="/noticias" class="see-all">Ver mais &rarr;</a>
      </div>
      <NewsSourceList sources={internationalSources} />
    </section>
  </div>
</BaseLayout>

<style>
  .hero-section {
    text-align: center;
    margin-bottom: 3rem;
  }

  .hero-section h1 {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto 1.75rem auto;
  }

  .search-box {
    margin-top: 1rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .categories-section {
    margin-bottom: 3rem;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .category-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  .category-card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .cat-name {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1.05rem;
  }

  .cat-desc {
    font-size: 0.825rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .featured-section {
    margin-bottom: 3rem;
  }

  .sources-section {
    margin-bottom: 3.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .section-header h2 {
    font-size: 1.35rem;
    font-weight: 700;
  }

  .see-all {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-blue);
  }
</style>