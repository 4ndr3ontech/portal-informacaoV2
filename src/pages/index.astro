---
import BaseLayout from '../layouts/BaseLayout.astro';
import SourceCard from '../components/SourceCard.astro';
import { getFaviconUrl, getCountryFlag, getCategoryIcon } from '../lib/utils';

import fontesGlobais from '../data/clean-news-sources.json';
import rawFontesBrasil from '../data/brazil-sources.json';
import type { NewsSource } from '../types';

// Garante segurança nos arrays
const fontesOriginais: NewsSource[] = Array.isArray(fontesGlobais)
  ? fontesGlobais
  : ((fontesGlobais as any).default || []);

const fontesBrasil: NewsSource[] = Array.isArray(rawFontesBrasil) 
  ? rawFontesBrasil 
  : ((rawFontesBrasil as any).default || []);

// Como o clean-news-sources.json já está totalmente limpo, juntamos diretamente ao acervo do Brasil
const sources: NewsSource[] = [...fontesOriginais, ...fontesBrasil];

const featuredSource = sources.find(s => s.id === 'bbc-news-brasil') || sources[0];
const totalSources = sources.length;

// Limita a renderização inicial no servidor para evitar o Erro 1102 da Cloudflare
const INITIAL_RENDER_LIMIT = 12;
const initialSources = sources.slice(0, INITIAL_RENDER_LIMIT);

const categoriesList = [
  { slug: 'brasil', label: 'Brasil', desc: 'Principais veículos de notícias nacionais' },
  { slug: 'mundo', label: 'Mundo', desc: 'Análises e acontecimentos internacionais' },
  { slug: 'politica', label: 'Política', desc: 'Bastidores dos poderes executivo e legislativo' },
  { slug: 'economia', label: 'Economia', desc: 'Mercado financeiro, negócios e finanças' },
  { slug: 'tecnologia', label: 'Tecnologia', desc: 'IA, software, inovação e cultura digital' },
  { slug: 'games', label: 'Games', desc: 'Lançamentos, eSports e cultura gamer' },
  { slug: 'esportes', label: 'Esportes', desc: 'Futebol, ligas mundiais e modalidades' },
  { slug: 'ciencia', label: 'Ciência', desc: 'Pesquisas, astronomia e descobertas' },
  { slug: 'saude', label: 'Saúde', desc: 'Avanços médicos e políticas públicas' },
  { slug: 'entretenimento', label: 'Entretenimento', desc: 'Filmes, séries, música e cultura' },
  { slug: 'educacao', label: 'Educação', desc: 'Enem, vestibulares, concursos e carreiras' },
  { slug: 'investimentos', label: 'Investimentos', desc: 'FIIs, ações, criptomoedas e finanças' }
];
---

<BaseLayout 
  title="Início | O mundo em um click"
  description="Acesse os principais jornais online e portais de notícias do Brasil e do mundo. Encontre fontes de informação sobre política, economia, tecnologia, esportes e atualidades em uma única plataforma."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16 w-full">
    
    <!-- Hero Section com Pesquisa Inteligente em Tempo Real -->
    <section class="relative text-center py-12 px-4 rounded-3xl bg-white border border-slate-200/80 shadow-xl shadow-slate-200/40 overflow-hidden">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-cyan-500/10 blur-3xl rounded-full pointer-events-none"></div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 mb-4 max-w-4xl mx-auto leading-tight">
        O mundo inteiro em um <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-blue-600">só lugar</span>
      </h1>

      <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto mb-8 font-bold leading-relaxed">
        Acesse os principais jornais online e portais de notícias do Brasil e do mundo. Encontre fontes de informação sobre política, economia, tecnologia, esportes e atualidades em uma única plataforma.
      </p>

      <!-- Input de Pesquisa Interativa -->
      <div class="max-w-2xl mx-auto relative group">
        <div class="flex items-center rounded-2xl bg-white border border-slate-300 p-2 shadow-lg shadow-slate-200/50 focus-within:border-cyan-500 focus-within:ring-2 focus-within:ring-cyan-500/20 transition-all">
          <span class="pl-3 text-slate-400 text-lg">🔍</span>
          <input
            id="search-input"
            type="text"
            aria-label="Pesquise por portais, temas ou palavras-chave (ex: Economia, G1, Inteligência Artificial...)"
            placeholder="Pesquise por portais, temas ou palavras-chave (ex: Economia, G1, Inteligência Artificial...)"
            class="w-full bg-transparent px-3 py-2 text-slate-900 placeholder-slate-400 focus:outline-none text-sm font-bold"
          />
        </div>
      </div>

      <!-- Contador de fontes dinâmico atualizado -->
      <div id="results-count" class="mt-6 text-slate-600 font-extrabold text-sm tracking-wide">
        Exibindo <span class="text-cyan-600 font-black text-base">{totalSources}</span> fontes de informação ativas
      </div>
    </section>

    <!-- Explore por Categoria -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">Explore por Categoria</h2>
          <p class="text-sm font-bold text-slate-500 mt-1">Navegue pelas editorias mais acessadas do portal</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {categoriesList.map(cat => (
          <a
            href={`/noticias?category=${cat.slug}`}
            class="group p-5 rounded-2xl bg-white border border-slate-200 hover:border-cyan-500/50 hover:shadow-xl hover:shadow-cyan-500/5 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between shadow-sm"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-3xl p-2 rounded-xl bg-slate-50 border border-slate-200/80 group-hover:scale-110 group-hover:border-cyan-500/30 transition-all shadow-2xs">
                  {getCategoryIcon(cat.slug)}
                </span>
                <span class="text-xs text-slate-400 group-hover:text-cyan-600 transition-colors font-mono font-bold">
                  Explorar ↗
                </span>
              </div>
              <h3 class="text-base font-black text-slate-900 group-hover:text-cyan-600 transition-colors">
                {cat.label}
              </h3>
              <p class="text-xs text-slate-600 font-bold mt-1 line-clamp-2 leading-relaxed">
                {cat.desc}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Veículo em Destaque -->
    {featuredSource && (
      <section class="space-y-4" id="featured-section">
        <div class="flex items-center gap-2">
          <span class="h-2.5 w-2.5 rounded-full bg-cyan-500 animate-pulse"></span>
          <h2 class="text-xl font-black text-slate-900">Veículo em Destaque</h2>
        </div>

        <div class="relative rounded-2xl border border-cyan-500/40 bg-white p-6 lg:p-8 shadow-xl shadow-cyan-500/5 flex flex-col md:flex-row md:items-center justify-between gap-6 overflow-hidden">
          <div class="space-y-4 max-w-2xl">
            <div class="flex items-center gap-3.5">
              <img
                id="featured-logo"
                src={getFaviconUrl(featuredSource.url, 128)}
                alt={`Logo ${featuredSource.name}`}
                class="h-14 w-14 rounded-xl bg-slate-50 p-2 object-contain border border-slate-200/80 shadow-md"
                loading="lazy"
                {...{ onerror: "this.onerror=null; this.src='/default-icon.svg';" }}
              />
              <div>
                <span class="text-xs font-black text-cyan-600 uppercase tracking-widest">
                  Destaque da Semana
                </span>
                <h3 class="text-2xl sm:text-3xl font-black text-slate-900 flex items-center gap-2">
                  <button
                    type="button"
                    id="featured-name-btn"
                    class="open-source-modal hover:text-cyan-600 transition-colors cursor-pointer text-left"
                    data-source={JSON.stringify(featuredSource)}
                  >
                    <span id="featured-name">{featuredSource.name}</span>
                  </button>
                  <span id="featured-flag" class="text-lg">{getCountryFlag(featuredSource.country || 'Global')}</span>
                </h3>
              </div>
            </div>

            <p id="featured-desc" class="text-slate-600 text-sm font-bold leading-relaxed">
              {featuredSource.description || 'Plataforma e veículo de comunicação.'}
            </p>

            <div id="featured-categories" class="flex flex-wrap items-center gap-2 pt-1">
              {(featuredSource.categories || ['geral']).map((cat: string) => (
                <span class="text-xs px-2.5 py-1 rounded-lg bg-slate-100/80 text-slate-700 border border-slate-200/80 shadow-2xs flex items-center gap-1 font-black">
                  <span>{getCategoryIcon(cat)}</span>
                  <span class="capitalize">{cat}</span>
                </span>
              ))}
            </div>
          </div>

          <div class="flex flex-col sm:flex-row md:flex-col gap-3 min-w-[200px]">
            <a
              id="featured-url"
              href={featuredSource.url}
              target="_blank"
              rel="noopener noreferrer"
              data-track-source={featuredSource.id}
              class="track-click-btn px-5 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-black text-xs uppercase tracking-wider text-center transition-all shadow-lg shadow-cyan-500/20 active:scale-95"
            >
              Acessar portal oficial ↗
            </a>
            <button
              type="button"
              id="featured-modal-trigger"
              class="open-source-modal px-5 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-200 text-xs uppercase tracking-wider font-black text-center transition-all cursor-pointer shadow-2xs"
              data-source={JSON.stringify(featuredSource)}
            >
              Ver ficha completa
            </button>
          </div>
        </div>
      </section>
    )}

    <!-- Todos os Veículos -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">Todos os Veículos</h2>
          <p class="text-sm font-bold text-slate-500 mt-1">Pesquise para encontrar fontes por assunto</p>
        </div>
        <a href="/noticias?country=BR" class="text-xs font-black uppercase tracking-wider text-cyan-600 hover:text-cyan-700 flex items-center gap-1 transition-colors">
          Ver lista completa ➔
        </a>
      </div>

      <div id="sources-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-stretch">
        {initialSources.map((source: NewsSource, index: number) => (
          <div 
            class="source-card-wrapper w-full h-full flex flex"
            data-original-index={index}
            data-name={source.name.toLowerCase()}
            data-desc={(source.description || '').toLowerCase()}
            data-categories={JSON.stringify(source.categories || []).toLowerCase()}
          >
            <SourceCard source={source} />
          </div>
        ))}
      </div>

      <div id="no-results" class="hidden text-center py-16 space-y-3">
        <p class="text-2xl font-black text-slate-700">Nenhum portal encontrado para esta pesquisa.</p>
        <p class="text-sm font-bold text-slate-500">Tente pesquisar por outros termos (ex: tecnologia, jogos, economia, notícias).</p>
      </div>
    </section>

  </main>
</BaseLayout>

<script is:inline define:vars={{ allSources: sources }}>
  document.addEventListener('DOMContentLoaded', () => {
    const featuredLogo = document.getElementById('featured-logo');
    const featuredName = document.getElementById('featured-name');
    const featuredNameBtn = document.getElementById('featured-name-btn');
    const featuredModalTrigger = document.getElementById('featured-modal-trigger');
    const featuredFlag = document.getElementById('featured-flag');
    const featuredDesc = document.getElementById('featured-desc');
    const featuredCategories = document.getElementById('featured-categories');
    const featuredUrl = document.getElementById('featured-url');
    
    const searchInput = document.getElementById('search-input');
    const sourcesGrid = document.getElementById('sources-grid');
    const noResultsMsg = document.getElementById('no-results');
    const resultsCount = document.getElementById('results-count');

    const countryFlags = {
      BR: '🇧🇷', US: '🇺🇸', GB: '🇬🇧', AR: '🇦🇷', MX: '🇲🇽',
      CL: '🇨🇱', CO: '🇨🇴', PE: '🇵🇪', UY: '🇺🇾', ES: '🇪🇸',
      PT: '🇵🇹', FR: '🇫🇷', DE: '🇩🇪', IT: '🇮🇹', CA: '🇨🇦',
      AU: '🇦🇺', JP: '🇯🇵', CN: '🇨🇳', IN: '🇮🇳'
    };

    const categoryIcons = {
      brasil: '🇧🇷', mundo: '🌐', politica: '⚖️', economia: '📈',
      tecnologia: '💻', ciencia: '🔬', saude: '🏥', esportes: '⚽', geral: '📌',
      games: '🎮', entretenimento: '🎬', educacao: '📚', investimentos: '💰'
    };

    const getClicks = (id) => parseInt(localStorage.getItem(`clicks_${id}`) || '0', 10);
    const setClicks = (id, count) => localStorage.setItem(`clicks_${id}`, count.toString());

    if (searchInput && sourcesGrid) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();

        if (query === '') {
          const initialSlice = allSources.slice(0, 12);
          sourcesGrid.innerHTML = initialSlice.map((source, index) => `
            <div class="source-card-wrapper w-full h-full flex flex" data-name="${source.name.toLowerCase()}" data-desc="${(source.description || '').toLowerCase()}" data-categories="${JSON.stringify(source.categories || []).toLowerCase()}">
              <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between w-full">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <img src="https://www.google.com/s2/favicons?domain=${source.url}&sz=64" alt="Logo" class="h-10 w-10 rounded-xl bg-slate-50 p-2 object-contain border border-slate-200" />
                    <span class="text-xs font-black px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">${source.country || 'Global'}</span>
                  </div>
                  <h3 class="text-lg font-black text-slate-900 mb-2">${source.name}</h3>
                  <p class="text-slate-600 text-xs font-bold line-clamp-2">${source.description || ''}</p>
                </div>
                <div class="mt-4 pt-4 border-t border-slate-100">
                  <a href="${source.url}" target="_blank" rel="noopener noreferrer" class="text-xs font-black text-cyan-600 hover:text-cyan-700 uppercase tracking-wider">Acessar portal ↗</a>
                </div>
              </div>
            </div>
          `).join('');

          if (resultsCount) {
            resultsCount.innerHTML = `Exibindo <span class="text-cyan-600 font-black text-base">${allSources.length}</span> fontes de informação ativas`;
          }
          if (noResultsMsg) noResultsMsg.classList.add('hidden');
          return;
        }

        const matched = allSources.filter(source => {
          const name = (source.name || '').toLowerCase();
          const desc = (source.description || '').toLowerCase();
          const cats = JSON.stringify(source.categories || []).toLowerCase();
          return name.includes(query) || desc.includes(query) || cats.includes(query);
        });

        if (matched.length > 0) {
          sourcesGrid.innerHTML = matched.map((source) => `
            <div class="source-card-wrapper w-full h-full flex flex">
              <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between w-full">
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <img src="https://www.google.com/s2/favicons?domain=${source.url}&sz=64" alt="Logo" class="h-10 w-10 rounded-xl bg-slate-50 p-2 object-contain border border-slate-200" />
                    <span class="text-xs font-black px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">${source.country || 'Global'}</span>
                  </div>
                  <h3 class="text-lg font-black text-slate-900 mb-2">${source.name}</h3>
                  <p class="text-slate-600 text-xs font-bold line-clamp-2">${source.description || ''}</p>
                </div>
                <div class="mt-4 pt-4 border-t border-slate-100">
                  <a href="${source.url}" target="_blank" rel="noopener noreferrer" class="text-xs font-black text-cyan-600 hover:text-cyan-700 uppercase tracking-wider">Acessar portal ↗</a>
                </div>
              </div>
            </div>
          `).join('');
          if (noResultsMsg) noResultsMsg.classList.add('hidden');
        } else {
          sourcesGrid.innerHTML = '';
          if (noResultsMsg) noResultsMsg.classList.remove('hidden');
        }

        if (resultsCount) {
          resultsCount.innerHTML = `Encontradas <span class="text-cyan-600 font-black text-base">${matched.length}</span> fontes correspondentes a "${query}"`;
        }
      });
    }

    function updateFeaturedCard() {
      if (!allSources || allSources.length === 0) return;

      const sortedSources = [...allSources].map(s => ({
        ...s,
        clicks: getClicks(s.id)
      })).sort((a, b) => b.clicks - a.clicks);

      const topSource = sortedSources[0];

      if (topSource && featuredName) {
        featuredName.textContent = topSource.name;
        if (featuredFlag) featuredFlag.textContent = countryFlags[topSource.country] || '🌐';
        if (featuredDesc) featuredDesc.textContent = topSource.description || 'Plataforma e veículo de comunicação.';
        if (featuredLogo) {
          featuredLogo.src = `https://www.google.com/s2/favicons?domain=${topSource.url}&sz=128`;
          featuredLogo.alt = `Logo ${topSource.name}`;
        }
        if (featuredUrl) {
          featuredUrl.href = topSource.url;
          featuredUrl.setAttribute('data-track-source', topSource.id);
        }

        const serializedSource = JSON.stringify(topSource);
        if (featuredNameBtn) featuredNameBtn.setAttribute('data-source', serializedSource);
        if (featuredModalTrigger) featuredModalTrigger.setAttribute('data-source', serializedSource);

        if (featuredCategories) {
          const cats = topSource.categories || ['geral'];
          featuredCategories.innerHTML = cats.map(cat => `
            <span class="text-xs px-2.5 py-1 rounded-lg bg-slate-100/80 text-slate-700 border border-slate-200/80 shadow-2xs flex items-center gap-1 font-black">
              <span>${categoryIcons[cat] || '📌'}</span>
              <span class="capitalize">${cat}</span>
            </span>
          `).join('');
        }
      }
    }

    updateFeaturedCard();

    document.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (!link) return;

      let sourceId = link.getAttribute('data-track-source');
      if (!sourceId && link.href) {
        const match = link.href.match(/\/fontes\/([a-zA-Z0-9-]+)/);
        if (match) sourceId = match[1];
      }

      if (sourceId) {
        const currentClicks = getClicks(sourceId) + 1;
        setClicks(sourceId, currentClicks);
        updateFeaturedCard();
      }
    });
  });
</script>