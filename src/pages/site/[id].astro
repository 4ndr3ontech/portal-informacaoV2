---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fontesGlobaisJson from '../../data/clean-news-sources.json';
import { sources as fontesBrasil } from '../../data/sources';
import type { NewsSource } from '../../types';

// Força a página a ser estática no build
export const prerender = true;

export async function getStaticPaths() {
  const fontesGlobais: NewsSource[] = Array.isArray(fontesGlobaisJson)
    ? (fontesGlobaisJson as NewsSource[])
    : ((fontesGlobaisJson as any)?.default || []);

  const rawAllSources: NewsSource[] = [...fontesGlobais, ...fontesBrasil];
  
  const allSources = Array.from(
    new Map(
      rawAllSources
        .filter(source => source && source.id)
        .map(source => [source.id, source])
    ).values()
  );

  return allSources.map((source) => ({
    params: { id: source.id },
    props: { source },
  }));
}

const { source } = Astro.props as { source: NewsSource };

const categories = source.categories || ['Geral'];
const country = source.country || 'BR';
const language = (source as any).language || 'PT-BR';
const type = (source as any).type || 'Portal';
const lastVerified = (source as any).lastVerified || '2026-10-20';
const rank = (source as any).rank ? `RANK #${(source as any).rank}` : null;
---

<BaseLayout title={`${source.name} | O Mundo em um Clique`}>
  <!-- Fundo da página com gradientes suaves para destacar a transparência -->
  <main class="relative min-h-[calc(100vh-80px)] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 overflow-hidden bg-slate-50">
    
    <!-- Luzes abstratas no fundo (Necessárias para o efeito de vidro funcionar visualmente) -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
      <div class="absolute -top-[10%] -left-[10%] w-[60%] h-[60%] bg-cyan-400/20 rounded-full blur-[120px]"></div>
      <div class="absolute top-[20%] -right-[10%] w-[50%] h-[50%] bg-blue-500/15 rounded-full blur-[120px]"></div>
      <div class="absolute -bottom-[10%] left-[20%] w-[50%] h-[50%] bg-emerald-400/10 rounded-full blur-[100px]"></div>
    </div>

    <!-- O Cartão Central (z-10) -->
    <div class="relative z-10 w-full max-w-3xl mx-auto">
      
      <!-- CARTÃO COM EFEITO VIDRO (Glassmorphism): bg-white/70 + backdrop-blur -->
      <article class="bg-white/70 backdrop-blur-2xl rounded-3xl border border-white shadow-2xl overflow-hidden">
        
        <!-- Cabeçalho do Cartão com leve transparência -->
        <div class="bg-slate-900/95 backdrop-blur-md text-white px-6 sm:px-10 py-6 flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2">
            {categories.map((cat: string) => (
              <span class="px-3.5 py-1 bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 text-[11px] font-black uppercase tracking-wider rounded-full">
                {cat}
              </span>
            ))}
          </div>

          {rank && (
            <span class="text-[11px] font-black tracking-widest text-slate-300 bg-slate-800/80 px-3.5 py-1.5 rounded-xl border border-slate-700/60 uppercase">
              {rank}
            </span>
          )}
        </div>

        <!-- Conteúdo do Card -->
        <div class="p-6 sm:p-12 space-y-8">
          
          <!-- Nome do Site e Metadados Regionais -->
          <div>
            <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight">
              {source.name}
            </h1>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mt-2">
              País: <span class="text-slate-800">{country}</span> · Idioma: <span class="text-slate-800">{language}</span>
            </p>
          </div>
          
          <!-- Descrição Oficial -->
          <div class="space-y-4 text-slate-700 font-medium leading-relaxed text-base sm:text-lg">
            <p class="text-slate-900 font-semibold leading-relaxed">
              {source.description || 'Nenhuma descrição informada para este veículo no momento.'}
            </p>
            <p class="text-slate-600 text-base leading-relaxed">
              O portal <strong>{source.name}</strong> é uma fonte de informações catalogada no diretório <em>O Mundo em um Clique</em>. Ele se destaca pela relevância em seu nicho de atuação e pela entrega de conteúdo diário para o público.
            </p>
          </div>

          <!-- Metadados / Detalhes Adicionais -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 py-6 border-y border-slate-200/60 text-sm">
            <div>
              <span class="block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1">Tipo de Mídia</span>
              <span class="font-extrabold text-slate-900 capitalize">{type}</span>
            </div>
            <div>
              <span class="block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1">Última Verificação</span>
              <span class="font-extrabold text-slate-900">{lastVerified}</span>
            </div>
            <div>
              <span class="block text-[10px] font-black uppercase tracking-wider text-slate-500 mb-1">Situação</span>
              <span class="font-black text-emerald-600 flex items-center gap-1.5 mt-0.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Ativo e Verificado
              </span>
            </div>
          </div>

          <!-- Botões de Ação -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
            <a 
              href="/noticias" 
              class="w-full sm:w-auto text-center px-6 py-3.5 rounded-xl border border-slate-300/80 bg-white/50 text-slate-700 hover:text-slate-900 hover:bg-white font-bold text-xs transition-all uppercase tracking-wider"
            >
              ← Voltar ao Diretório
            </a>
            
            <a 
              href={source.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full sm:w-auto text-center bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-black py-4 px-8 rounded-xl shadow-lg shadow-cyan-600/25 transition-all active:scale-95 uppercase tracking-wide text-xs sm:text-sm"
            >
              Acessar {source.name} ↗
            </a>
          </div>

        </div>
      </article>

    </div>
  </main>
</BaseLayout>