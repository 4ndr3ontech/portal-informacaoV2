---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import AffiliateProductCard from '../../components/AffiliateProductCard.astro';
import { products } from '../../data/products';

const activeProducts = products.filter((p) => p.active);
---

<BaseLayout 
  title="Ofertas Selecionadas e Recomendadas | PortalInfo" 
  description="Seleção editorial de produtos e equipamentos recomendados com links diretos para o Mercado Livre."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8 w-full">
    
    <!-- Cabeçalho da Página -->
    <header class="text-center space-y-3 max-w-3xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Ofertas Selecionadas
      </h1>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        Produtos úteis para leitura, trabalho, tecnologia e produtividade recomendados pela equipe do portal.
      </p>
    </header>

    <!-- Componente de Aviso de Transparência -->
    <AffiliateDisclosure />

    <!-- Grid de Produtos -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {activeProducts.map((product) => (
        <AffiliateProductCard product={product} />
      ))}
    </section>

  </main>
</BaseLayout>