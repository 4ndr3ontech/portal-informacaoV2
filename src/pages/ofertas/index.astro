---
export const prerender = false; // Permite a busca em tempo real no banco de dados

import '../../styles/global.css';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Conexão com o banco D1 para buscar as ofertas dinâmicas
let offers: any[] = [];
try {
  const db = Astro.locals.runtime.env.DB;
  const result = await db.prepare('SELECT * FROM offers ORDER BY created_at DESC').all();
  offers = result.results || [];
} catch (error) {
  console.error('Erro ao carregar as ofertas:', error);
}
---

<BaseLayout 
  title="Ofertas Selecionadas | OMundoEmUmCLICK" 
  description="Produtos úteis para leitura, trabalho, tecnologia e produtividade recomendados pela equipe do portal."
>
  <!-- CABEÇALHO COM CORES SÓLIDAS E ALTO CONTRASTE -->
  <header class="bg-white py-12 px-4 border-b border-slate-200">
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900">
        Ofertas Selecionadas
      </h1>
      <p class="text-slate-600 font-bold text-lg">
        Produtos úteis para leitura, trabalho, tecnologia e produtividade recomendados pela equipe do portal.
      </p>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full min-h-[60vh]">
    
    <!-- Grid de Produtos / Ofertas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {offers.map((offer) => {
        // Formatação inteligente do preço promocional
        let formattedPrice = 'Consulte';
        if (offer.price) {
          const cleanPrice = String(offer.price).trim();
          if (cleanPrice.startsWith('R$')) {
            formattedPrice = cleanPrice;
          } else if (cleanPrice.includes(',')) {
            formattedPrice = `R$ ${cleanPrice}`;
          } else {
            const num = Number(cleanPrice.replace(',', '.'));
            formattedPrice = !isNaN(num) && num > 0 
              ? `R$ ${num.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` 
              : `R$ ${cleanPrice}`;
          }
        }

        // Formatação do preço original (riscado)
        let formattedOriginalPrice = '';
        if (offer.original_price && offer.original_price !== '0,00' && offer.original_price !== offer.price) {
          const cleanOrig = String(offer.original_price).trim();
          if (cleanOrig.startsWith('R$')) {
            formattedOriginalPrice = cleanOrig;
          } else if (cleanOrig.includes(',')) {
            formattedOriginalPrice = `R$ ${cleanOrig}`;
          } else {
            const numOrig = Number(cleanOrig.replace(',', '.'));
            formattedOriginalPrice = !isNaN(numOrig) && numOrig > 0 
              ? `R$ ${numOrig.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` 
              : `R$ ${cleanOrig}`;
          }
        }

        return (
          <article class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
            
            <div>
              <!-- Badge de Categoria/Destaque -->
              <div class="flex items-center justify-between mb-4">
                <span class="bg-slate-100 text-slate-700 text-[10px] px-2.5 py-1 rounded-lg font-black uppercase tracking-wider border border-slate-200">
                  Destaque
                </span>
                <span class="text-[10px] font-black text-amber-600 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                  ⭐ Recomendado
                </span>
              </div>

              <!-- Imagem Ilustrativa / Espaço de Preview -->
              <div class="w-full h-40 bg-slate-50 rounded-2xl border border-slate-100 flex items-center justify-center mb-5 text-slate-400 overflow-hidden">
                {offer.image_url ? (
                  <img src={offer.image_url} alt={offer.title} class="w-full h-full object-cover" />
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                )}
              </div>

              <!-- Título e Descrição -->
              <h3 class="text-base font-black text-slate-900 mb-2 leading-snug line-clamp-2">
                {offer.title}
              </h3>
              {offer.description && (
                <p class="text-slate-600 font-bold text-xs mb-6 line-clamp-3 leading-relaxed">
                  {offer.description}
                </p>
              )}
            </div>

            <!-- Preços e Botão de Ação -->
            <div class="pt-4 border-t border-slate-100 mt-auto space-y-4">
              <div class="flex items-baseline gap-2">
                <span class="text-xl font-black text-cyan-600">{formattedPrice}</span>
                {formattedOriginalPrice && (
                  <span class="text-xs font-bold text-slate-400 line-through">
                    {formattedOriginalPrice}
                  </span>
                )}
              </div>

              <a 
                href={offer.affiliate_link} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-black text-xs uppercase tracking-wider transition-all shadow-md active:scale-95"
              >
                <span>Ver Oferta</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

          </article>
        );
      })}
      
      {/* Mensagem caso não tenha nenhuma oferta no banco */}
      {offers.length === 0 && (
        <div class="col-span-full py-12 text-center">
          <p class="text-slate-500 font-bold">Nenhuma oferta disponível no momento. Volte em breve!</p>
        </div>
      )}
    </div>

  </main>
</BaseLayout>