---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import AffiliateProductCard from '../../components/AffiliateProductCard.astro';
import { products } from '../../data/products';

const activeProducts = products.filter((p) => p.active);
---

<BaseLayout 
  title="Ofertas Selecionadas e Recomendadas" 
  description="Seleção editorial de produtos e equipamentos recomendados com links diretos para o Mercado Livre."
>
  <div class="container">
    <header class="page-header">
      <h1>Ofertas Selecionadas</h1>
      <p class="page-subtitle">Produtos úteis para leitura, trabalho, tecnologia e produtividade recomendados pela equipe do portal.</p>
    </header>

    <AffiliateDisclosure />

    <section class="products-grid">
      {activeProducts.map((product) => (
        <AffiliateProductCard product={product} />
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 650px;
    margin: 0 auto;
  }

  .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>