---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Fale Conosco" 
  description="Entre em contato para sugerir novos veículos de notícias, comunicar correções ou enviar mensagens."
>
  <div class="container content-page">
    <header class="page-header">
      <h1>Fale Conosco</h1>
      <p class="lead">Envie sugestões de veículos, correções de links ou dúvidas gerais.</p>
    </header>

    <div class="contact-grid">
      <form id="contact-form" class="contact-form" novalidate>
        <div id="form-feedback" class="feedback-msg" hidden></div>

        <div class="form-group">
          <label for="name">Seu Nome *</label>
          <input type="text" id="name" name="name" required placeholder="Digite seu nome completo" />
          <span class="field-error" id="error-name"></span>
        </div>

        <div class="form-group">
          <label for="email">Endereço de E-mail *</label>
          <input type="email" id="email" name="email" required placeholder="seuemail@exemplo.com" />
          <span class="field-error" id="error-email"></span>
        </div>

        <div class="form-group">
          <label for="subject">Assunto *</label>
          <input type="text" id="subject" name="subject" required placeholder="Ex: Sugestão de novo veículo" />
          <span class="field-error" id="error-subject"></span>
        </div>

        <div class="form-group">
          <label for="message">Sua Mensagem *</label>
          <textarea id="message" name="message" rows="5" required placeholder="Escreva os detalhes da sua mensagem..."></textarea>
          <span class="field-error" id="error-message"></span>
        </div>

        <button type="submit" class="submit-btn">Enviar Mensagem</button>
      </form>

      <aside class="contact-info">
        <h3>Informações de Atendimento</h3>
        <p>Prezamos pela precisão dos dados do nosso diretório. Caso note um veículo inativo ou URL incorreta, informe-nos.</p>
        
        <div class="info-box">
          <strong>Horário de Análise:</strong>
          <p>Segunda a Sexta, das 09h às 18h.</p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { validateContactForm } from '../lib/validation';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    document.querySelectorAll('.field-error').forEach((el) => el.textContent = '');

    const formData = {
      name: (document.getElementById('name') as HTMLInputElement)?.value,
      email: (document.getElementById('email') as HTMLInputElement)?.value,
      subject: (document.getElementById('subject') as HTMLInputElement)?.value,
      message: (document.getElementById('message') as HTMLTextAreaElement)?.value,
    };

    const validation = validateContactForm(formData);

    if (!validation.isValid) {
      Object.entries(validation.errors).forEach(([field, msg]) => {
        const errorEl = document.getElementById(`error-${field}`);
        if (errorEl) errorEl.textContent = msg;
      });
      return;
    }

    if (feedback) {
      feedback.textContent = 'Mensagem enviada com sucesso! Agradecemos o seu contato.';
      feedback.className = 'feedback-msg success';
      feedback.removeAttribute('hidden');
    }
    form.reset();
  });
</script>

<style>
  .content-page {
    max-width: 900px;
    margin: 0 auto;
  }

  .page-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .contact-form {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: var(--text-primary);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.65rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-blue);
  }

  .field-error {
    font-size: 0.775rem;
    color: #ef4444;
    display: block;
    margin-top: 0.25rem;
  }

  .submit-btn {
    background-color: var(--accent-blue);
    color: #ffffff;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    font-weight: 700;
    cursor: pointer;
    width: 100%;
  }

  .submit-btn:hover {
    background-color: var(--accent-blue-hover);
  }

  .feedback-msg {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .feedback-msg.success {
    background-color: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }

  .contact-info h3 {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }

  .contact-info p {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .info-box {
    background-color: var(--bg-secondary);
    padding: 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }

  .info-box strong {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .info-box p {
    margin-bottom: 0;
    font-weight: 600;
  }
</style>