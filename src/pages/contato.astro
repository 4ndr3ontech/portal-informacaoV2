---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Fale Conosco | OMundoEmUmCLICK" 
  description="Entre em contato para sugerir novos veículos de notícias, comunicar correções ou enviar mensagens."
>
  <!-- CABEÇALHO CLARO (FUNDO BRANCO) -->
  <header class="bg-white text-slate-900 py-12 px-4 border-b border-slate-200">
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-500 to-blue-600 pb-2">
        Fale Conosco
      </h1>
      <p class="text-slate-600 font-bold text-lg">
        Envie sugestões de veículos, correções de links ou dúvidas gerais.
      </p>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full min-h-[60vh]">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <!-- COLUNA ESQUERDA: FORMULÁRIO -->
      <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm">
        <form id="contact-form" class="space-y-6" novalidate>
          
          <!-- Mensagem de Feedback -->
          <div id="form-feedback" hidden></div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <!-- Nome -->
            <div class="space-y-2">
              <label for="name" class="block text-sm font-black text-slate-700">Seu Nome *</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                placeholder="Digite seu nome completo" 
                class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3.5 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all font-bold text-sm" 
              />
              <span class="field-error text-xs text-red-500 font-bold block mt-1" id="error-name"></span>
            </div>

            <!-- E-mail -->
            <div class="space-y-2">
              <label for="email" class="block text-sm font-black text-slate-700">Endereço de E-mail *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="seuemail@exemplo.com" 
                class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3.5 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all font-bold text-sm" 
              />
              <span class="field-error text-xs text-red-500 font-bold block mt-1" id="error-email"></span>
            </div>
          </div>

          <!-- Assunto -->
          <div class="space-y-2">
            <label for="subject" class="block text-sm font-black text-slate-700">Assunto *</label>
            <input 
              type="text" 
              id="subject" 
              name="subject" 
              required 
              placeholder="Ex: Sugestão de novo veículo" 
              class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3.5 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all font-bold text-sm" 
            />
            <span class="field-error text-xs text-red-500 font-bold block mt-1" id="error-subject"></span>
          </div>

          <!-- Mensagem -->
          <div class="space-y-2">
            <label for="message" class="block text-sm font-black text-slate-700">Sua Mensagem *</label>
            <textarea 
              id="message" 
              name="message" 
              rows="6" 
              required 
              placeholder="Escreva os detalhes da sua mensagem..." 
              class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3.5 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all font-bold text-sm resize-y"
            ></textarea>
            <span class="field-error text-xs text-red-500 font-bold block mt-1" id="error-message"></span>
          </div>

          <!-- Botão Enviar -->
          <div class="pt-2">
            <button 
              type="submit" 
              id="submit-btn"
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-black text-sm uppercase tracking-wider transition-all shadow-md active:scale-95 cursor-pointer"
            >
              Enviar Mensagem
            </button>
          </div>

        </form>
      </div>

      <!-- COLUNA DIREITA: INFORMAÇÕES -->
      <aside class="space-y-6">
        <div class="bg-slate-50 rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-sm">
          <h3 class="text-xl font-black text-slate-900 mb-4 flex items-center gap-2">
            <span class="text-cyan-600 text-2xl">ℹ️</span> Atendimento
          </h3>
          
          <p class="text-slate-600 font-bold text-sm leading-relaxed mb-8 pb-6 border-b border-slate-200">
            Prezamos pela precisão dos dados do nosso diretório. Caso note um veículo inativo ou URL incorreta, informe-nos.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="p-3 bg-white rounded-xl border border-slate-200 shadow-sm text-cyan-600 text-xl">
                🕒
              </div>
              <div>
                <h4 class="font-black text-slate-900 text-sm">Horário de Análise</h4>
                <p class="text-slate-600 font-bold text-sm mt-1">Segunda a Sexta<br/>09h às 18h</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="p-3 bg-white rounded-xl border border-slate-200 shadow-sm text-cyan-600 text-xl">
                ✉️
              </div>
              <div>
                <h4 class="font-black text-slate-900 text-sm">E-mail Direto</h4>
                <a href="mailto:contato@omundoemumclick.com.br" class="text-cyan-600 hover:text-cyan-700 font-bold text-sm mt-1 inline-block transition-colors">
                  contato@omundoemumclick.com.br
                </a>
              </div>
            </div>
          </div>
        </div>
      </aside>

    </div>
  </main>
</BaseLayout>

<script>
  import { validateContactForm } from '../lib/validation';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Limpar erros anteriores
    document.querySelectorAll('.field-error').forEach((el) => el.textContent = '');

    const formData = {
      name: (document.getElementById('name') as HTMLInputElement)?.value,
      email: (document.getElementById('email') as HTMLInputElement)?.value,
      subject: (document.getElementById('subject') as HTMLInputElement)?.value,
      message: (document.getElementById('message') as HTMLTextAreaElement)?.value,
    };

    const validation = validateContactForm(formData);

    if (!validation.isValid) {
      Object.entries(validation.errors).forEach(([field, msg]) => {
        const errorEl = document.getElementById(`error-${field}`);
        if (errorEl) errorEl.textContent = msg as string;
      });
      return;
    }

    // Desativa o botão temporariamente durante o envio
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'A enviar...';
    }

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData)
      });

      const result = await response.json();

      if (feedback) {
        if (response.ok && result.success) {
          feedback.textContent = 'Mensagem enviada com sucesso! Agradecemos o seu contato.';
          feedback.className = 'p-4 rounded-xl mb-6 text-sm font-bold bg-green-100 text-green-800 border border-green-200';
          feedback.removeAttribute('hidden');
          form.reset();
        } else {
          feedback.textContent = result.message || 'Ocorreu um erro ao enviar. Tente novamente.';
          feedback.className = 'p-4 rounded-xl mb-6 text-sm font-bold bg-red-100 text-red-800 border border-red-200';
          feedback.removeAttribute('hidden');
        }
      }
    } catch (error) {
      if (feedback) {
        feedback.textContent = 'Erro de conexão com o servidor. Verifique sua rede.';
        feedback.className = 'p-4 rounded-xl mb-6 text-sm font-bold bg-red-100 text-red-800 border border-red-200';
        feedback.removeAttribute('hidden');
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar Mensagem';
      }
    }
  });
</script>