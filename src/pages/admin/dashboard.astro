---
export const prerender = false;

import '../../styles/global.css';
import BaseLayout from '../../layouts/BaseLayout.astro';

// ATENÇÃO:
// Esta validação é apenas uma verificação provisória.
// Em produção, utilize uma sessão autenticada e assinada,
// validada no servidor, com expiração e revogação.

const session = Astro.cookies.get('admin_session');

if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}
---

<BaseLayout
  title="Painel Administrativo | O Mundo em um Clique"
  description="Área administrativa para gerenciamento de ofertas e acompanhamento das funcionalidades do portal."
>
  <main class="min-h-[calc(100vh-140px)] bg-slate-50 py-10 sm:py-12 px-4 sm:px-6 lg:px-8">

    <div class="max-w-7xl mx-auto">

      <!-- Cabeçalho do painel -->
      <section class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-5 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm mb-8">

        <div>
          <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-wider text-cyan-700 bg-cyan-50 px-2.5 py-1 rounded border border-cyan-100 mb-2">
            Área segura
          </span>

          <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            Painel de Controlo
          </h1>
        </div>

        <!-- Ações do cabeçalho -->
        <div class="flex items-center gap-3 flex-wrap">

          <a
            href="/"
            class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs uppercase tracking-wider rounded-lg transition-colors border border-slate-200"
          >
            Ver Site
          </a>

          <a
            href="/admin/logout"
            class="px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 font-semibold text-xs uppercase tracking-wider rounded-lg transition-colors flex items-center gap-2 border border-red-100"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
              />
            </svg>
            Sair
          </a>

        </div>

      </section>

      <!-- Indicadores do painel -->
      <section
        aria-label="Informações administrativas"
        class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8"
      >

        <article class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center gap-2 mb-2">
             <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
            <h2 class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
              Estado do Sistema
            </h2>
          </div>
          <p class="text-xl font-bold text-slate-900">
            Online & SSR Ativo
          </p>
          <p class="text-[11px] text-slate-500 font-medium mt-1">
             Acesso restrito verificado
          </p>
        </article>

        <article class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-2 h-2 rounded-full bg-cyan-500"></div>
            <h2 class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
              Autenticação
            </h2>
          </div>
          <p class="text-xl font-bold text-slate-900">
            Sessão Ativa
          </p>
          <p class="text-[11px] text-slate-500 font-medium mt-1">
            Protegido por Cookies
          </p>
        </article>

        <article class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
           <div class="flex items-center gap-2 mb-2">
             <div class="w-2 h-2 rounded-full bg-amber-500"></div>
            <h2 class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
              Permissões
            </h2>
          </div>
          <p class="text-xl font-bold text-slate-900">
            Administrador
          </p>
          <p class="text-[11px] text-slate-500 font-medium mt-1">
            Acesso total ao portal
          </p>
        </article>

      </section>

      <!-- Ferramentas administrativas -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Ações rápidas -->
        <article class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
             <h2 class="text-lg font-bold text-slate-900 mb-6">
              Ações Rápidas
             </h2>
          
             <div class="flex flex-wrap gap-3">
               <a
                 href="/admin/ofertas"
                 class="px-4 py-2.5 bg-cyan-700 hover:bg-cyan-600 text-white rounded-lg text-[11px] font-semibold uppercase tracking-wider transition-colors shadow-sm flex items-center gap-2"
               >
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6" />
                 </svg>
                 Gerir Ofertas
               </a>

               <a
                 href="/admin/boletim"
                 class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-[11px] font-semibold uppercase tracking-wider transition-colors shadow-sm flex items-center gap-2"
               >
                 <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                 </svg>
                 Mensagens / Boletim
               </a>
             </div>
          </div>
          
           <div class="mt-6">
              <a
                 href="/"
                 target="_blank"
                 rel="noopener noreferrer"
                 class="inline-flex px-4 py-2 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-lg text-[11px] font-semibold uppercase tracking-wider transition-colors border border-slate-200 items-center gap-1.5"
               >
                 Ver Portal
                 <span aria-hidden="true" class="text-xs">↗</span>
               </a>
           </div>

        </article>

        <!-- Smart Paste -->
        <article class="bg-slate-900 p-6 sm:p-8 rounded-2xl shadow-md relative overflow-hidden">

          <div class="absolute top-0 right-0 p-6 opacity-5" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-28 w-28 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>

          <div class="relative z-10">

            <div class="mb-5">
              <h2 class="text-lg font-bold text-white flex items-center gap-2">
                 <span class="text-cyan-400">⚡</span> Smart Paste
              </h2>
              <p class="text-[11px] text-slate-400 mt-1">
                Adicione ofertas rapidamente usando links curtos (meli.la).
              </p>
            </div>

            <form id="smart-paste-form" class="space-y-4">
              <input
                type="url"
                id="url"
                name="url"
                placeholder="Cole o link do Mercado Livre aqui..."
                autocomplete="url"
                required
                maxlength="2048"
                class="w-full px-4 py-2.5 rounded-lg border border-slate-700 bg-slate-800 text-slate-200 placeholder-slate-500 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 focus:outline-none text-sm transition-all"
              />

              <button
                type="submit"
                id="submit-btn"
                class="w-full bg-cyan-600 hover:bg-cyan-500 disabled:opacity-50 disabled:cursor-not-allowed text-white font-bold text-[11px] uppercase tracking-wider px-6 py-3 rounded-lg transition-colors"
              >
                Extrair e Guardar
              </button>
            </form>

            <div
              id="status-message"
              class="mt-4 hidden p-3 rounded-lg font-medium text-xs text-center border"
              role="status"
              aria-live="polite"
            ></div>

          </div>

        </article>

      </section>

    </div>

  </main>

  <!-- Processamento do Smart Paste -->
  <script>
    const form = document.getElementById('smart-paste-form') as HTMLFormElement | null;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const status = document.getElementById('status-message') as HTMLDivElement | null;
    const urlInput = document.getElementById('url') as HTMLInputElement | null;

    function showStatus(message: string, type: 'success' | 'error') {
      if (!status) return;

      status.textContent = message;

      status.className = type === 'success'
        ? 'mt-4 p-3 rounded-lg font-medium text-xs text-center bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
        : 'mt-4 p-3 rounded-lg font-medium text-xs text-center bg-red-500/10 text-red-400 border border-red-500/20';

      status.hidden = false;
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form || !btn || !urlInput || !urlInput.value.trim()) {
        return;
      }

      const submittedUrl = urlInput.value.trim();

      if (!urlInput.checkValidity()) {
        urlInput.reportValidity();
        return;
      }

      btn.disabled = true;
      btn.textContent = 'PROCESSANDO...';

      if (status) {
        status.hidden = true;
      }

      try {
        const response = await fetch('/api/salvar-oferta', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({
            url: submittedUrl,
          }),
        });

        const contentType = response.headers.get('content-type') || '';

        if (!contentType.includes('application/json')) {
          throw new Error('O servidor retornou uma resposta inesperada.');
        }

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            typeof data.error === 'string'
              ? data.error
              : 'Não foi possível processar o produto.'
          );
        }

        showStatus(
          'Solicitação processada. Verifique o cadastro para confirmar os dados da oferta.',
          'success'
        );

        form.reset();

      } catch (error) {
        const message = error instanceof Error
          ? error.message
          : 'Ocorreu um erro inesperado. Tente novamente.';

        showStatus(`Não foi possível concluir a operação: ${message}`, 'error');

      } finally {
        btn.disabled = false;
        btn.textContent = 'EXTRAIR E GUARDAR';
      }
    });
  </script>

</BaseLayout>