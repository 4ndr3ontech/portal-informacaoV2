---
export const prerender = false;

import '../../styles/global.css';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Validação de segurança
const session = Astro.cookies.get('admin_session');
if (!session || session.value !== 'authenticated') {
  return Astro.redirect('/admin/login');
}

let message = '';
const db = Astro.locals.runtime.env.DB;

// Processar a resposta do administrador para os contactos
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const msgId = data.get('id')?.toString();
    const adminReply = data.get('admin_reply')?.toString().trim();

    if (msgId && adminReply) {
      await db.prepare(
        "UPDATE contact_submissions SET status = 'respondido', admin_reply = ? WHERE id = ?"
      ).bind(adminReply, msgId).run();
      
      message = 'Resposta registada com sucesso!';
    }
  } catch (error) {
    message = 'Erro ao guardar a resposta.';
  }
}

// Buscar mensagens de contacto
let contatos: any[] = [];
try {
  const resultContatos = await db.prepare('SELECT * FROM contact_submissions ORDER BY created_at DESC').all();
  contatos = resultContatos.results || [];
} catch (e) {
  // Tabela pode não existir ainda
}

// Buscar inscritos no boletim informativo (Newsletter)
let newsletterSubscribers: any[] = [];
try {
  const resultNews = await db.prepare('SELECT * FROM newsletter_subscribers ORDER BY created_at DESC').all();
  newsletterSubscribers = resultNews.results || [];
} catch (e) {
  // Tabela pode não existir ainda
}
---

<BaseLayout title="Boletim e Mensagens | Admin" description="Gestão de contactos e inscrições no boletim.">
  <main class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-12">
      
      <!-- Cabeçalho -->
      <div class="flex justify-between items-center bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
        <div>
          <h1 class="text-2xl font-black text-slate-900">Mensagens e Boletim Informativo</h1>
          <p class="text-sm text-slate-500 font-bold mt-1">Gira os contactos e consulte os inscritos na newsletter</p>
        </div>
        <a href="/admin/dashboard" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-black text-xs uppercase tracking-wider rounded-2xl border border-slate-200 transition-colors">
          Voltar ao Painel
        </a>
      </div>

      {message && (
        <div class={`p-4 rounded-2xl text-sm font-black border ${message.includes('Erro') ? 'bg-red-50 text-red-700 border-red-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200'}`}>
          {message}
        </div>
      )}

      <!-- SEÇÃO 1: INSCRITOS NO BOLETIM (NEWSLETTER) -->
      <div class="space-y-6">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-black text-slate-900">Inscritos no Boletim ({newsletterSubscribers.length})</h2>
        </div>

        {newsletterSubscribers.length > 0 ? (
          <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="divide-y divide-slate-100">
              {newsletterSubscribers.map((sub: any) => (
                <div class="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50/50 transition-colors">
                  <div>
                    <p class="text-sm font-black text-slate-900">
                      <a href={`mailto:${sub.email}`} class="text-cyan-600 hover:underline">{sub.email}</a>
                    </p>
                    <span class="text-xs text-slate-400 font-bold">
                      Inscrito em: {sub.created_at ? new Date(sub.created_at).toLocaleString('pt-PT') : 'Data não registada'}
                    </span>
                  </div>
                  <span class="px-3 py-1 bg-cyan-50 text-cyan-700 text-xs font-black rounded-lg border border-cyan-100 w-fit">
                    Ativo
                  </span>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="bg-white p-8 text-center rounded-3xl border border-slate-200 shadow-sm">
            <p class="text-slate-500 font-bold text-sm">Nenhum e-mail inscrito no boletim informativo ainda.</p>
          </div>
        )}
      </div>

      <!-- SEÇÃO 2: MENSAGENS DE CONTACTO -->
      <div class="space-y-6 pt-6 border-t border-slate-200">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-black text-slate-900">Mensagens de Contacto ({contatos.length})</h2>
        </div>

        <div class="space-y-6">
          {contatos.map((contato: any) => (
            <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex flex-col md:flex-row gap-6">
              
              <!-- Dados da Mensagem -->
              <div class="flex-1 space-y-3">
                <div class="flex items-center gap-3">
                  <h3 class="text-lg font-black text-slate-900">{contato.name}</h3>
                  <span class={`text-[10px] font-black uppercase tracking-wider px-2 py-1 rounded-lg border ${contato.status === 'respondido' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-700 border-amber-200'}`}>
                    {contato.status === 'respondido' ? 'Respondido' : 'Pendente'}
                  </span>
                </div>
                
                <div class="text-sm font-bold text-slate-500">
                  <p>E-mail: <a href={`mailto:${contato.email}`} class="text-cyan-600 hover:underline">{contato.email}</a></p>
                  <p>Assunto: {contato.subject}</p>
                  <p class="text-xs mt-1 opacity-70">Enviado em: {new Date(contato.created_at).toLocaleString('pt-PT')}</p>
                </div>
                
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 text-slate-700 text-sm leading-relaxed">
                  {contato.message}
                </div>
              </div>

              <!-- Área de Resposta -->
              <div class="flex-1 bg-slate-50 p-5 rounded-2xl border border-slate-100">
                {contato.status === 'respondido' ? (
                  <div>
                    <h4 class="text-xs font-black text-slate-400 uppercase tracking-wider mb-2">A sua resposta:</h4>
                    <p class="text-sm font-bold text-slate-700 bg-white p-4 rounded-xl border border-slate-200">
                      {contato.admin_reply}
                    </p>
                  </div>
                ) : (
                  <form method="POST" class="space-y-3 h-full flex flex-col">
                    <input type="hidden" name="id" value={contato.id} />
                    <label class="block text-xs font-black text-slate-700 uppercase">Responder a {contato.name}</label>
                    <textarea 
                      name="admin_reply" 
                      required 
                      rows="3" 
                      placeholder="Escreva a sua resposta (será guardada no histórico)..." 
                      class="w-full flex-1 bg-white border border-slate-300 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20"
                    ></textarea>
                    <button type="submit" class="w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-black uppercase tracking-wider transition-colors">
                      Marcar como Respondido
                    </button>
                  </form>
                )}
              </div>

            </div>
          ))}

          {contatos.length === 0 && (
            <div class="bg-white p-8 text-center rounded-3xl border border-slate-200 shadow-sm">
              <p class="text-slate-500 font-bold text-sm">A caixa de entrada de contactos está vazia.</p>
            </div>
          )}
        </div>
      </div>

    </div>
  </main>
</BaseLayout>