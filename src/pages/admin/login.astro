---
import '../../styles/global.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Acesso Administrativo | OMundoEmUmCLICK" 
  description="Área restrita para a gestão e administração de fontes de mídia do portal."
>
  <!-- Main Container com Fundo Totalmente Branco e Limpo -->
  <main class="min-h-[calc(100vh-140px)] bg-white flex items-center justify-center px-4 py-16 relative">
    
    <!-- Caixa Principal de Login Estilizada para Fundo Claro -->
    <div class="w-full max-w-md bg-white border border-slate-200 rounded-3xl p-8 sm:p-10 shadow-lg shadow-slate-100 relative z-10">
      
      <!-- Cabeçalho do Card -->
      <div class="text-center space-y-3 mb-8">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-cyan-50 border border-cyan-200 text-cyan-600 mb-1 shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Área Restrita
        </h1>
        <p class="text-slate-500 font-bold text-xs uppercase tracking-widest">
          Painel de Administração
        </p>
      </div>

      <!-- Formulário de Autenticação -->
      <form class="space-y-6" method="POST">
        
        <div class="space-y-2">
          <label for="username" class="block text-xs font-black text-slate-700 uppercase tracking-wider">
            Usuário ou E-mail
          </label>
          <div class="relative">
            <input 
              type="text" 
              id="username" 
              name="username" 
              required
              placeholder="admin@portalinfo.com" 
              class="w-full bg-slate-50 border border-slate-300 rounded-2xl px-4 py-3.5 text-slate-900 placeholder-slate-400 font-bold text-sm focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all shadow-xs"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label for="password" class="block text-xs font-black text-slate-700 uppercase tracking-wider">
            Palavra-passe
          </label>
          <div class="relative">
            <input 
              type="password" 
              id="password" 
              name="password" 
              required
              placeholder="••••••••" 
              class="w-full bg-slate-50 border border-slate-300 rounded-2xl px-4 py-3.5 text-slate-900 placeholder-slate-400 font-bold text-sm focus:outline-none focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 transition-all shadow-xs"
            />
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full py-4 px-6 rounded-2xl bg-cyan-600 hover:bg-cyan-500 text-white font-black text-xs uppercase tracking-wider transition-all shadow-md active:scale-95 cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Entrar no Sistema</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>

      </form>

      <!-- Rodapé do Card / Voltar -->
      <div class="mt-8 pt-6 border-t border-slate-100 text-center">
        <a 
          href="/" 
          class="inline-flex items-center gap-1.5 text-xs font-black text-slate-500 hover:text-cyan-600 transition-colors"
        >
          <span>&larr; Voltar para a página inicial</span>
        </a>
      </div>

    </div>
  </main>
</BaseLayout>