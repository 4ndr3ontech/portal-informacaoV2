---
import BaseLayout from '../../layouts/BaseLayout.astro';
import sources from '../../data/clean-news-sources.json';

export const prerender = true;

export async function getStaticPaths() {
  return sources.map((source: any) => ({
    params: { slug: source.slug || source.id },
    props: { source }
  }));
}

const { source } = Astro.props;

if (!source) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={`${source.name} — Perfil da Fonte | O Mundo em um Clique`} description={source.description}>
  
  <!-- Cabeçalho do Perfil -->
  <section class="bg-slate-950 text-white py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
    <div class="max-w-4xl mx-auto space-y-6">
      
      <div class="flex flex-wrap items-center gap-3 text-xs font-black uppercase tracking-wider text-cyan-400">
        <span class="px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-500/30">
          {source.mediaType || 'Portal de Notícias'}
        </span>
        <span>PAÍS: <strong>{source.country || 'Global'}</strong></span>
        <span>IDIOMA: <strong>{source.language || (source.country === 'BR' ? 'pt-BR' : 'en/Multilíngue')}</strong></span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white flex items-center gap-4">
        {source.favicon && (
          <img src={source.favicon} alt={`Logo ${source.name}`} class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl border border-slate-800 bg-white p-1" />
        )}
        {source.name}
      </h1>

      <p class="text-base sm:text-lg font-bold text-slate-300 leading-relaxed max-w-3xl">
        {source.description || 'Portal catalogado e verificado no diretório global de fontes de informação.'}
      </p>

      <div class="pt-4 flex flex-wrap items-center gap-4">
        <a 
          href={source.url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-cyan-600 hover:bg-cyan-500 text-slate-950 font-black text-xs uppercase tracking-wider transition-all shadow-lg shadow-cyan-600/20"
        >
          Acessar Site Oficial ↗
        </a>
        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 font-black text-xs uppercase tracking-wider transition-all"
        >
          ← Voltar ao Diretório
        </a>
      </div>

    </div>
  </section>

  <!-- Detalhes e Transparência do Perfil -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto w-full space-y-8">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Informações Técnicas -->
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4 md:col-span-1">
        <h2 class="text-lg font-black text-slate-900">Ficha Técnica</h2>
        <ul class="space-y-3 text-xs font-bold text-slate-600">
          <li class="flex justify-between border-b border-slate-100 pb-2">
            <span>Tipo de Mídia:</span>
            <strong class="text-slate-900 capitalize">{source.mediaType || 'Portal'}</strong>
          </li>
          <li class="flex justify-between border-b border-slate-100 pb-2">
            <span>País de Origem:</span>
            <strong class="text-slate-900">{source.countryName || (source.country === 'BR' ? 'Brasil' : 'Global')}</strong>
          </li>
          <li class="flex justify-between border-b border-slate-100 pb-2">
            <span>Rank Global:</span>
            <strong class="text-slate-900">#{source.rank || 'N/A'}</strong>
          </li>
          <li class="flex justify-between border-b border-slate-100 pb-2">
            <span>Estado da Verificação:</span>
            <strong class="text-emerald-600">Ativo e Verificado</strong>
          </li>
        </ul>
      </div>

      <!-- Análise Editorial e Transparência -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm space-y-4 md:col-span-2">
        <h2 class="text-xl font-black text-slate-900">Sobre a Curadoria desta Fonte</h2>
        <p class="text-slate-600 font-bold text-sm leading-relaxed">
          Esta publicação faz parte do diretório independente <strong>O Mundo em um Clique</strong>. A inclusão tem como objetivo orientar utilizadores interessados em consultar conteúdos legítimos, oferecendo acesso direto ao portal oficial de <em>{source.name}</em>.
        </p>
        <div class="pt-4 border-t border-slate-100 space-y-2">
          <h3 class="text-sm font-black text-slate-900">Categorias Associadas:</h3>
          <div class="flex flex-wrap gap-2">
            {source.categories && source.categories.length > 0 ? (
              source.categories.map((cat: string) => (
                <span class="px-3 py-1 bg-slate-100 border border-slate-200 rounded-lg text-slate-900 text-xs font-black capitalize">
                  {cat}
                </span>
              ))
            ) : (
              <span class="px-3 py-1 bg-slate-100 border border-slate-200 rounded-lg text-slate-900 text-xs font-black">
                Geral
              </span>
            )}
          </div>
        </div>
      </div>

    </div>

  </section>

</BaseLayout>